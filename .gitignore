HELP.md
.gradle
build/
# 삭제된 cpf-tools/build composite source는 다시 추적하지 않습니다.
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
!**/src/main/**/bin/
!**/src/test/**/bin/

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr
out/
!**/src/main/**/out/
!**/src/test/**/out/

### NetBeans ###
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

### VS Code ###
.vscode/*

### CPF runtime logs ###
logs/
**/logs/
# ADM의 거래 로그 화면 Source는 runtime log 디렉터리가 아닙니다.
!cpf-admin/frontend/src/features/logs/
!cpf-admin/frontend/src/features/logs/**
*.log
*.log.*

### Frontend build cache ###
**/node_modules/
**/coverage/
**/.vite/

# 공식 Evidence 디렉터리는 정제된 검증 결과와 현재 요청 기준 해시만 허용합니다.
!cpf-docs/evidence/
cpf-docs/evidence/**
!cpf-docs/evidence/**/
!cpf-docs/evidence/**/*.sanitized.log
!cpf-docs/evidence/**/*.sanitized.json
!cpf-docs/evidence/**/*.sanitized.png
# Evidence 계약 정본은 실행 원문과 분리해 추적합니다.
!cpf-docs/evidence/templates/**/*.json
!cpf-docs/evidence/schema/**/*.json
!cpf-docs/evidence/fixtures/**/*.json
!cpf-docs/evidence/**/cpf-current-work-request.baseline.sha256

### CPF transient runtime directories ###
/tmp/
/temp/
*.tmp
*.bak
*.orig
*.rej
*.patch
*.zip
*.7z
*.tar
*.gz
*.class
*.hprof
*.stackdump
*.pid
*.pid.lock
*.swp
*~
hs_err_pid*.log
replay_pid*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
Thumbs.db
.DS_Store

# cpf-tools/build contains tracked BOM/convention-plugin source; nested Gradle outputs stay ignored.
!/cpf-tools/build/
!/cpf-tools/build/platform-bom/
!/cpf-tools/build/platform-bom/settings.gradle
!/cpf-tools/build/platform-bom/build.gradle
!/cpf-tools/build/gradle-plugin/
!/cpf-tools/build/gradle-plugin/settings.gradle
!/cpf-tools/build/gradle-plugin/build.gradle
!/cpf-tools/build/gradle-plugin/src/
!/cpf-tools/build/gradle-plugin/src/**
/cpf-tools/build/**/build/
/cpf-tools/build/**/.gradle/
