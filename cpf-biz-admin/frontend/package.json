{
  "name": "cpf-bza-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.16.0",
    "npm": "10.9.2"
  },
  "scripts": {
    "generate:api": "orval --config orval.config.ts",
    "verify:generated": "node scripts/verify-generated-client.mjs",
    "build": "npm run verify:generated && vite build",
    "lint": "eslint src vite.config.ts playwright.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "verify:primary": "node scripts/verify-primary-frontend.mjs",
    "verify": "npm run verify:primary && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@tanstack/vue-query": "5.101.4",
    "@tanstack/vue-table": "8.21.3",
    "element-plus": "2.14.3",
    "pinia": "4.0.2",
    "vue": "3.5.40",
    "vue-router": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.1",
    "@typescript-eslint/parser": "8.64.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "10.10.0",
    "jsdom": "29.1.1",
    "orval": "8.23.0",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
