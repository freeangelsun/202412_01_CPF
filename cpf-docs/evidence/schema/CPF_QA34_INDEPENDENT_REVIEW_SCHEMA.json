{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPF QA34 Independent Fresh Clone Review",
  "type": "object",
  "required": ["schemaVersion","evidenceId","reviewType","sourceSha","resultSha","sourceDirty","reviewer","startedAt","finishedAt","exitCode","requirements","commands","candidateIndexSha256","findings","sanitized","releaseEligible"],
  "properties": {
    "schemaVersion": {"const": 3},
    "reviewType": {"const": "INDEPENDENT_FRESH_CLONE"},
    "sourceSha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "resultSha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "sourceDirty": {"const": false},
    "reviewer": {"type":"string","minLength":1},
    "exitCode": {"const": 0},
    "requirements": {"type":"array","contains":{"const":"QA34-REQ-020"}},
    "commands": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "candidateIndexSha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "findings": {"type":"array"},
    "sanitized": {"const": true},
    "releaseEligible": {"const": true}
  },
  "additionalProperties": true
}
