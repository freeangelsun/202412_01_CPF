    "verification_incomplete_reason",
    "source_identity"
  ],
  "completionConsistency": {
    "overallCompleteRequires": [
      "development_status=완료",
      "verification_status=완료",
      "runtime_status=PASS_OR_NOT_APPLICABLE",
      "DEVGPT execution_status=PASS",
      "INDEPENDENT_REVIEWER execution_status=PASS",
      "QA execution_status=PASS"
    ],
    "forbid": [
      "overall_status=완료 with any mandatory NOT_EXECUTED/FAIL/BLOCKED_EXTERNAL/UNKNOWN",
      "verification_status=완료 without test evidence",
      "QA PASS without exact source identity"
    ]
  },
  "hardcodingRule": {
    "policy": "EXPECTED_VALUES_FROM_CANONICAL_REGISTRY_OR_SOURCE_DISCOVERY_ONLY",
    "forbid": [
      "literal requirement totals as acceptance",
      "literal discovered file totals as acceptance",
      "expected=actual generated from same output without independent source",
      "waiver/suppression used to convert failing acceptance to pass"
    ]
  },
  "standaloneRuntimeRule": {
    "platforms": [
      "windows",
      "linux"
    ],
    "operations": [
      "prerequisite",
      "prepare",
      "start",
      "status",
      "verify",
      "stop",
      "cleanup",
      "fresh-replay"
    ],
    "parity": "same semantic operation, arguments, exit-code contract and evidence on both platforms; missing platform is BLOCKED_EXTERNAL/OPEN, never PASS"
  },
  "finalDeliveryRequiredArtifacts": [
    "overlayZip",
    "zipSha256Sidecar",
    "zipExtractReplayEvidence",
