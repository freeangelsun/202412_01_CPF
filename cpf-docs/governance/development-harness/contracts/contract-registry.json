    "UNKNOWN",
    "UNVERIFIED",
    "BLOCKED_EXTERNAL",
    "FAIL"
  ],
  "mandatoryRuntimePlatforms": [
    "windows",
    "linux"
  ],
  "completionRule": "all mandatory findings CLOSED + final gate PASS + mandatory runtime PASS + fresh replay PASS + recurrence 0 + new mandatory finding 0 + evidence/source identity exact match",
  "currentOnly": {
    "forbidHarnessNamePatterns": [
      "development-harness-v",
      "development-harness_old",
      "development-harness-old",
      "development-harness_backup",
