{
  "schemaVersion": "1.1",
  "harnessVersion": "1.1.3",
  "locked": true,
  "changeAuthority": "USER_EXPLICIT_REQUEST_ONLY",
  "global": {
    "one_section_one_question": true,
    "h1_intro_max_sentences": 2,
    "h1_intro_max_chars": 180,
    "h2_max_paragraphs": 2,
    "h2_max_sentences_total": 5,
    "h2_preferred_text_chars_excluding_tables_code": 420,
    "h2_review_chars_over": 650,
    "repeated_background_explanation": "forbidden",
    "generic_closing_checklist": "forbidden",
    "duplicate_content_across_adjacent_sections": "forbidden",
    "when_detail_exceeds_limit": "move exact contract details to Specification/Source, keep decision/use/failure essentials in guide"
  },
  "microBlocks": {
    "developer": [
      "언제 사용: 1문장",
      "선택/API: Compact table 또는 2~5개 불릿",
      "예: 3~8줄 코드가 실제 이해를 빠르게 할 때만",
      "주의/실패: 최대 3개 불릿",
      "확인: 1~2개 불릿",
      "Source/EDU: 1줄"
    ],
    "operator": [
      "상황: 1문장",
      "확인/판단: 2~4개 불릿 또는 4열 이하 Runbook 표",
      "조치: 최대 4단계",
      "금지/권한: 필요한 경우만",
      "완료 기준: 1~2개 불릿"
    ],
    "architecture": [
