      "선택/금지: Decision 또는 짧은 표"
    ],
    "standard": [
      "규칙 Summary: 필수/금지 중심",
      "예: 올바른/잘못된 예 각각 1개",
      "검사: 최대 3개 불릿"
    ],
    "specification": [
      "정의: 1~2문장",
      "Contract compact table",
      "실패/호환성: 필요한 항목만",
      "Source exact path"
    ]
  },
