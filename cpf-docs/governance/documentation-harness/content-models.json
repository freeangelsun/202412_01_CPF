{
  "schemaVersion": "1.1",
  "harnessVersion": "1.1.3",
  "locked": true,
  "models": {
    "BROCHURE_PANEL": {
      "sequence": [
        "numbered_value_heading",
        "one_sentence_lead",
        "optional_distinct_visual",
        "caption_1_to_2_sentences",
        "max_3_key_points",
        "deep_link_if_needed"
      ],
      "rules": {
        "heading": "번호 + CPF 차별점/효익이 자연스럽게 드러나는 제목. 장점/왜 좋은가 라벨 금지.",
        "lead": "1~2문장, 150자 이내.",
        "detail": "핵심 2~4개 불릿 또는 짧은 문단 1개.",
        "visual": "정보를 더 빨리 이해시킬 때만. 같은 Template 반복 금지."
      }
    },
    "DEVELOPER_CAPABILITY_CHAPTER": {
      "sequence": [
        "one_sentence_purpose",
        "compact_selection",
        "minimal_example_if_useful",
        "failure_or_caution",
        "verification",
        "source_navigation"
      ],
      "rules": {
        "selection": "하려는 일→기능/API→핵심 옵션→선택 기준. 4열 이하.",
        "example": "3~8줄을 기본.",
        "failure": "최대 3개 불릿.",
        "source": "1줄 exact path."
      }
    },
    "OPERATOR_RUNBOOK_CHAPTER": {
      "sequence": [
        "one_sentence_situation",
        "check_and_judge",
        "action",
        "forbidden_or_approval_if_needed",
        "completion"
      ],
      "rules": {
        "check_and_judge": "최대 4개 불릿 또는 RUNBOOK 4열 표.",
        "action": "최대 4단계.",
        "completion": "1~2개 불릿."
      }
    },
    "ARCHITECTURE_CHAPTER": {
      "sequence": [
        "responsibility_boundary",
        "distinct_figure_if_needed",
        "normal_and_failure",
        "decision_or_forbidden",
        "source_map"
      ],
      "rules": {
        "responsibility_boundary": "2~4개 불릿.",
        "figure": "Module/Owner/Boundary/Flow를 실제로 보여줄 때만.",
        "decision": "최대 4열 표 또는 4개 불릿."
      }
    },
    "SPEC_CONTRACT_CHAPTER": {
      "sequence": [
        "definition",
        "compact_contract",
        "failure_compatibility",
        "consumer_source"
      ],
      "rules": {
        "definition": "1~2문장.",
        "compact_contract": "API/Contract 상세는 compact table. 긴 prose 금지.",
        "source": "exact identifier/path."
      }
    },
    "STANDARD_RULE_CHAPTER": {
      "sequence": [
        "scope",
        "rule_summary",
        "one_correct_example",
        "one_incorrect_example",
        "verification"
      ],
      "rules": {
        "rule_summary": "필수/금지 중심. 권장/허용은 필요한 경우만.",
        "examples": "각 1개.",
        "verification": "최대 3개 불릿."
      }
    },
    "TECH_SPEC_CHAPTER": {
      "sequence": [
        "supported_scope",
        "canonical_and_selectable",
        "constraints_compatibility",
        "verification"
      ],
      "rules": {
        "supported_scope": "Source에서 확인되는 값만.",
        "verification": "최대 3개 확인 지점."
      }
    },
    "DB_STANDARD_CHAPTER": {
      "sequence": [
        "canonical_rule",
        "vendor_difference_if_any",
        "lifecycle_impact",
        "performance_locking_if_any",
        "verification"
      ],
      "rules": {
        "vendor_order": "Oracle → PostgreSQL → MariaDB.",
        "db_lifecycle": "DDL만 설명 금지. 실제 영향 있는 단계만 짧게."
      }
    },
    "DOCUMENT_INDEX_CHAPTER": {
      "sequence": [
        "reader_situation",
        "first_document",
        "answers",
        "next_document_if_needed"
      ],
      "rules": {
        "goal": "30초 안에 열 문서를 판단. 단순 파일 목록 금지."
      }
    }
  }
}
