{
  "schemaVersion": "1.0",
  "harnessVersion": "1.0.0",
  "locked": true,
  "page": {
    "paper": "A4",
    "portrait_mm": {
      "width": 210,
      "height": 297
    },
    "landscape_mm": {
      "width": 297,
      "height": 210
    },
    "margins_mm": {
      "portrait": {
        "top": 10,
        "bottom": 10,
        "left": 11,
        "right": 11
      },
      "landscape": {
        "top": 10,
        "bottom": 10,
        "left": 10,
        "right": 10
      }
    },
    "header_distance_mm": 5.5,
    "footer_distance_mm": 6.5,
    "no_blank_paragraph_for_spacing": true,
    "h1_remaining_space_rule_mm": 55,
    "rule": "H1과 첫 본문/표/그림을 합쳐 55mm 이상 들어갈 공간이 남지 않으면 다음 페이지에서 시작한다. 공간이 충분하면 불필요한 강제 Page Break를 넣지 않는다."
  },
  "fonts": {
    "canonical_korean": "Noto Sans KR",
    "canonical_monospace": "Consolas",
    "font_availability_gate": "최종 렌더 환경에 canonical font가 없거나 PDF에서 대체 폰트가 발생하면 FAIL. 폰트 파일은 산출물에 포함하지 않는다.",
    "sizes_pt": {
      "document_title": 26,
      "subtitle": 12,
      "h1": 20,
      "h2": 15,
      "h3": 12.5,
      "body": 10.5,
      "table_header": 9.5,
      "table_body": 9.3,
      "code": 9.0,
      "caption": 9.0,
      "header_footer": 8.5
    },
    "minimum_any_readable_text_pt": 9.0
  },
  "paragraph": {
    "body_line_spacing_multiple": 1.22,
    "body_space_after_pt": 5.5,
    "h1_space_before_pt": 24,
    "h1_space_after_pt": 9,
    "h2_space_before_pt": 16,
    "h2_space_after_pt": 7,
    "h3_space_before_pt": 11,
    "h3_space_after_pt": 5,
    "h1_extra_visual_separation": "H1은 H2보다 최소 8pt 더 큰 선행 간격을 사용하며 이전 표/그림 직후에는 최소 18pt의 시각적 분리 공간을 확보한다.",
    "alignment": "left",
    "full_justification": "forbidden",
    "center_body_text": "forbidden",
    "first_line_indent_mm": 0,
    "keep_with_next": [
      "document_title",
      "h1",
      "h2",
      "h3",
      "caption_before_table_or_figure"
    ],
    "widow_orphan_control": true
  },
  "colors": {
    "body_text": "#202124",
    "secondary_text": "#5F6368",
    "page_background": "#FFFFFF",
    "primary": "#17324D",
    "accent": "#1D4ED8",
    "table_header_bg": "#17324D",
    "table_header_text": "#FFFFFF",
    "table_grid": "#D6DCE5",
    "table_group_bg": "#EEF3F8",
    "callout_note_bg": "#EFF6FF",
    "callout_note_border": "#2563EB",
    "callout_warning_bg": "#FFF7E6",
    "callout_warning_border": "#D97706",
    "callout_danger_bg": "#FEF2F2",
    "callout_danger_border": "#B91C1C",
    "contrast": {
      "normal_text_min": "4.5:1",
      "large_text_min": "3:1",
      "meaningful_graphic_min": "3:1",
      "preferred_body_target": "7:1"
    },
    "random_decorative_colors": "forbidden",
    "zebra_striping_default": false
  },
  "tables": {
    "alignment": "center_on_page",
    "header_alignment": "center",
    "body_default_alignment": "left",
    "center_allowed_only": [
      "ordinal",
      "boolean",
      "yn",
      "short_status",
      "short_code",
      "short_numeric_value"
    ],
    "center_forbidden": [
      "description",
      "role",
      "usage",
      "reason",
      "completion_criterion",
      "path",
      "command",
      "owner_explanation",
      "operation_judgment",
      "failure_cause",
      "recovery_action",
      "api_description",
      "general_sentence"
    ],
    "vertical_alignment": "center_for_short_value_top_for_multiline_explanation",
    "font_pt": 9.3,
    "header_font_pt": 9.5,
    "header_bold": true,
    "cell_padding_mm": {
      "top": 1.15,
      "bottom": 1.15,
      "left": 1.4,
      "right": 1.4
    },
    "grid_line_pt": 0.5,
    "outer_border_pt": 0.6,
    "header_bottom_border_pt": 0.8,
    "equal_width_default": "forbidden",
    "tblGrid_must_match_cell_width": true,
    "merge_cells": "forbidden_for_data_tables",
    "split_cells": "forbidden",
    "nested_tables": "forbidden",
    "completely_blank_rows_or_columns": "forbidden",
    "repeat_header_on_each_page": true,
    "manual_page_break_inside_table": "forbidden",
    "row_break_across_pages_default": false,
    "min_column_mm": 12,
    "min_description_column_mm": 42,
    "max_columns_portrait": 6,
    "max_columns_landscape": 8,
    "overflow_resolution_order": [
      "shorten wording without losing meaning",
      "reallocate column widths",
      "move secondary detail below table",
      "split one table by semantic group",
      "switch profile-authorized section to landscape only if the profile explicitly allows it",
      "reduce table font no lower than 9.0pt"
    ],
    "automatic_wrap": "minimize",
    "token_wrap_rule": "짧은 Code/상태/옵션/경로가 열이 좁아서 2줄 이상 자동 개행되면 FAIL. 설명문만 의미 단위 개행을 허용한다.",
    "multi_item_cell": {
      "two_or_three_short_items": "중간점(·) 또는 세로 막대(|)로 한 줄 구분",
      "four_or_more_or_long_items": "각 항목 앞에 ○를 사용한 셀 내부 mini-list",
      "manual_line_break_for_decoration": "forbidden"
    },
    "long_table_rule": "2페이지 이상이면 Header 반복, 행 분할 금지, 첫 행은 Header로 태그, 다음 페이지 시작 시 문맥이 유지되어야 한다."
  },
  "figures": {
    "caption_position": "below",
    "caption_alignment": "left",
    "caption_max_lines": 3,
    "informative_alt_text_required": true,
    "decorative_alt_text_empty": true,
    "min_text_pt_in_doc_figure": 10,
    "min_text_px_readme_visual": 28,
    "text_overflow": 0,
    "box_overflow": 0,
    "crop": 0,
    "overlap": 0,
    "broken_glyph": 0,
    "max_words_per_node_label": 3,
    "max_words_per_arrow_label": 2,
    "sentence_inside_diagram": "forbidden",
    "source_diagram_preference": [
      "SVG",
      "high-resolution PNG"
    ],
    "raster_min_width_px": 1600,
    "raster_min_height_px": 900,
    "readme_full_width": true,
    "side_by_side_readme_core_figures": "forbidden",
    "required_review_scales": [
      "fit page",
      "100%",
      "200% for high-risk labels"
    ],
    "caption_content": "그림이 보여주는 흐름/경계, CPF가 자동 처리하는 부분, 사용자가 얻는 실제 편의를 2~4문장으로 설명한다. 그림 제목을 반복하지 않는다."
  },
  "callouts": {
    "allowed": [
      "note",
      "warning",
      "danger"
    ],
    "max_per_page": 1,
    "style": "full-width or paragraph-width, white space + thin left semantic border; floating gray boxes forbidden",
    "gray_floating_box": "forbidden",
    "callout_as_primary_content": "forbidden"
  },
  "code": {
    "L1": "1~3 lines: annotation/property/signature",
    "L2": "3~8 lines: API invocation",
    "L3": "8~20 lines: small complete recipe",
    "L4": "over 20 lines: body forbidden; navigate to Source/EDU",
    "horizontal_scroll_in_doc": "forbidden",
    "line_wrap": "avoid by simplifying; never shrink below 9pt",
    "line_numbers": "off unless troubleshooting requires them"
  },
  "toc": {
    "all_documents_required": true,
    "docx_levels": [
      "H1",
      "H2"
    ],
    "h3_in_toc": false,
    "readme_visible_manual_toc": true,
    "toc_page_must_not_be_sparse": "목차가 1페이지의 35% 미만이면 표지와 목차 배치를 재조정하거나 2단 구성하지 않고 정보를 보강한다."
  },
  "visual_quality": {
    "blank_pages_allowed": 0,
    "heading_only_pages_allowed": 0,
    "broken_local_links_allowed": 0,
    "broken_image_links_allowed": 0,
    "orphan_table_rows": "0 where controllable",
    "low_density_tail_review_threshold_percent": 35,
    "mechanical_equal_width_tables_allowed": 0,
    "non_code_center_aligned_body_cells_allowed": 0,
    "final_visual_review_required": true,
    "contact_sheet_only_pass": "forbidden",
    "high_risk_pages_must_open_full_size": [
      "first page",
      "toc",
      "all figure pages",
      "widest table pages",
      "code-heavy pages",
      "table page boundaries",
      "last page"
    ]
  }
}
