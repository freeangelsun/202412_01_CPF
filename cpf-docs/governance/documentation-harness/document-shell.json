{
  "schemaVersion": "1.0",
  "harnessVersion": "2.15.1",
  "locked": true,
  "changeAuthority": "USER_EXPLICIT_REQUEST_ONLY",
  "docxShell": {
    "cover": {
      "required": true,
      "page": 1,
      "headerFooterOnCover": false,
      "alignmentException": "표지 Title/Subtitle만 중앙 정렬 허용",
      "elementsInOrder": [
        "CPF wordmark/text identity",
        "문서 제목",
        "문서 한 줄 목적",
        "대상 독자",
        "문서 버전"
      ],
      "titleMaxLines": 2,
      "purposeMaxLines": 2,
      "noDecorativeGrayBoxes": true,
      "noLongLegalText": true,
      "titleSingleLinePreferred": true,
      "titleOrphanWrap": "hard_fail",
      "readerFacingProvenance": "forbidden: Harness version/Source SHA/Source ZIP/build baseline are evidence-only"
    },
    "toc": {
      "required": true,
      "startsAfterCover": true,
      "heading": "목차",
      "levels": [
        "H1",
        "H2"
      ],
      "showH3": false,
      "pageNumbers": true,
      "hyperlinks": true,
      "manualTypedToc": "forbidden",
      "updateFieldsBeforeFinalPdf": true,
      "presentation": "numbered list with page numbers",
      "table": "forbidden",
      "repeatedCategoryColumn": "forbidden"
    },
    "numbering": {
      "H1": "1.",
      "H2": "1.1",
      "H3": "1)",
      "automaticMultilevelList": true,
      "manualNumberTyping": "forbidden"
    },
    "header": {
      "fromFirstContentPage": true,
      "left": "short document title",
      "right": "document version",
      "importantUniqueInformation": "forbidden"
    },
    "footer": {
      "fromTocOrContent": true,
      "left": "Core Platform Framework",
      "center": "blank",
      "right": "page number",
      "importantUniqueInformation": "forbidden"
    },
    "sectionStart": {
      "pageBreakEveryH1": false,
      "remainingSpaceRuleMm": 55,
      "h1SpaceBeforePt": 52,
      "h1AfterTableOrFigureMinPt": 24,
      "majorSectionExtraBreathing": "about one body line compared with ordinary block transition"
    },
    "lastPage": {
      "mustContainMeaningfulContent": true,
      "signaturePage": "forbidden unless deliverable profile explicitly requires",
      "lowDensityReviewBelowPercent": 35
    }
  },
  "readmeShell": {
    "order": [
      "Hero",
      "mandatory CPF architecture map",
      "5..8 concise functional H2 sections",
      "short documentation navigation",
      "Community & Evaluation License"
    ],
    "headingNumbering": "not required; exactly one product H1, functional H2 headings; benefit/promotional headings forbidden",
    "toc": "forbidden",
    "heroWidth": "100%",
    "coreVisualWidth": "100%",
    "unsupportedCssDependency": "forbidden",
    "heroRule": "Hero는 브랜드/한 줄 정의/핵심 플랫폼 인상만. 기능 카드 10개 이상을 Hero에 몰아넣지 않는다.",
    "scanability": "no TOC, no dense benefit list, no consecutive tables, no consecutive large figures without explanation"
  },
  "metadata": {
    "documentVersionFormat": "document revision only when useful to reader; never expose Harness version or Source SHA in user-facing body/cover/footer",
    "sourceIdentity": "user-facing README/DOCX/PDF forbidden; evidence/manifest only",
    "dates": "YYYY-MM-DD",
    "timezone": "KST when time is shown"
  },
  "opening": {
    "order": [
      "DOCUMENT_TITLE",
      "SUBTITLE optional",
      "OPENING_SUMMARY",
      "first H1 or navigation"
    ],
    "openingSummaryComponent": "OPENING_SUMMARY",
    "readerNeedTable": "forbidden",
    "provenanceMetadata": "forbidden in reader-facing shell"
  }
}
