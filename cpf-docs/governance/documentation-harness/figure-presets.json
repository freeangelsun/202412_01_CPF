{
  "schemaVersion": "1.1",
  "harnessVersion": "1.1.3",
  "locked": true,
  "commonRulesRef": "visual-system.json",
  "presets": {
    "README_HERO": {
      "aspect": "16:6",
      "minRaster": "1920x720",
      "layout": "brand hero + layered platform hint",
      "maxLabels": 8,
      "titleInside": false,
      "background": "dark",
      "decorativeOnly": false
    },
    "README_ARCHITECTURE_MAP": {
      "aspect": "16:9",
      "minRaster": "1920x1080",
      "layout": "layered architecture map",
      "maxPrimaryGroups": 7,
      "maxPrimaryNodes": 12,
      "required": "README",
      "mustShowOwnershipAndBoundary": true
    },
    "SPLIT_COMPARE": {
      "aspect": "16:9",
      "layout": "left/right contrast",
      "maxItemsPerSide": 4,
      "bestFor": [
        "Same JVM vs Remote",
        "Gateway vs Direct",
        "Before vs CPF"
      ]
    },
    "JOURNEY_FLOW": {
      "aspect": "16:9",
      "layout": "timeline/journey",
      "maxStages": 7,
      "exceptionLane": "below"
    },
    "RECOVERY_STATE_MAP": {
      "aspect": "16:9",
      "layout": "state ribbon + recovery branch",
      "maxStates": 7,
      "requiredLabelsWhenRelevant": [
        "UNKNOWN",
        "Reconcile"
      ]
    },
    "BATCH_CONTROL_EXECUTION_MAP": {
      "aspect": "16:9",
      "layout": "control plane over execution plane",
      "requiredNodes": [
        "Control Plane",
        "Scheduler",
        "Worker",
        "Center-Cut",
        "Agent"
      ],
      "showLeaseBoundary": true
    },
    "LIFECYCLE_PIPELINE": {
      "aspect": "16:9",
      "layout": "numbered pipeline",
      "maxStages": 7
    },
    "OPERATIONS_TRACE": {
      "aspect": "16:9",
      "layout": "multi-lane timeline",
      "lanes": [
        "transactionId",
        "operationId",
        "instanceId",
        "Log/Trace/Timeline"
      ],
      "maxLanes": 5
    },
    "CAPABILITY_LANDSCAPE": {
      "aspect": "16:9",
      "layout": "grouped landscape, not equal cards",
      "groupsMax": 6,
      "itemsPerGroupMax": 5
    },
    "DECISION_MAP": {
      "aspect": "16:9",
      "layout": "branching decision",
      "maxDecisionNodes": 5
    },
    "OWNERSHIP_BOUNDARY": {
      "aspect": "16:9",
      "layout": "nested/layered boundaries",
      "containersMax": 6,
      "dependencyArrowSingleDirection": true
    },
    "ARCHITECTURE_TOPOLOGY": {
      "aspect": "16:9",
      "layout": "layered architecture map",
      "maxPrimaryNodes": 12
    },
    "REQUEST_FLOW": {
      "aspect": "16:9",
      "layout": "journey/sequence",
      "maxStages": 7
    },
    "STATE_TRANSITION": {
      "aspect": "16:9",
      "layout": "state ribbon + recovery branch",
      "maxStates": 7
    },
    "LIFECYCLE": {
      "aspect": "16:9",
      "layout": "numbered pipeline",
      "maxStages": 7
    },
    "OPERATION_TRACE": {
      "aspect": "16:9",
      "layout": "multi-lane timeline",
      "maxLanes": 5
    },
    "DECISION_FLOW": {
      "aspect": "16:9",
      "layout": "branching decision",
      "maxDecisionNodes": 5
    },
    "DB3_LIFECYCLE": {
      "aspect": "16:9",
      "layout": "pipeline with three vendor bands",
      "vendorBands": [
        "Oracle",
        "PostgreSQL",
        "MariaDB"
      ]
    },
    "BATCH_TOPOLOGY": {
      "aspect": "16:9",
      "layout": "control plane over execution plane",
      "requiredNodes": [
        "Control Plane",
        "Scheduler",
        "Worker",
        "Center-Cut",
        "Agent"
      ]
    },
    "BATCH_RECOVERY": {
      "aspect": "16:9",
      "layout": "four-way recovery decision",
      "requiredLabels": [
        "Restart",
        "Rerun",
        "Reprocess",
        "Reconcile"
      ]
    },
    "GENERATOR_FLOW": {
      "aspect": "16:9",
      "layout": "numbered pipeline",
      "requiredStages": [
        "Domain Input",
        "Generator",
        "Generated Domain",
        "Starter/DB",
        "Build/Test"
      ]
    },
    "GATEWAY_OPTIONALITY": {
      "aspect": "16:9",
      "layout": "split compare",
      "requiredPaths": [
        "Gateway path",
        "Direct allowed path"
      ],
      "mustNotDepictAutomaticFallback": true
    },
    "SECURITY_AUDIT_FLOW": {
      "aspect": "16:9",
      "layout": "journey/approval trail",
      "requiredConcepts": [
        "Identity",
        "Permission",
        "Approval",
        "Audit"
      ]
    }
  }
}
