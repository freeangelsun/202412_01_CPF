{
  "schemaVersion": "1.1",
  "harnessVersion": "1.2.1",
  "locked": true,
  "commonRulesRef": "visual-system.json",
  "presets": {
    "README_HERO": {
      "aspect": "16:6",
      "minRaster": "1920x720",
      "layout": "brand hero + layered platform hint",
      "maxLabels": 8,
      "titleInside": false,
      "background": "dark",
      "decorativeOnly": false,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "README_ARCHITECTURE_MAP": {
      "aspect": "16:9",
      "minRaster": "1920x1080",
      "layout": "layered architecture map",
      "maxPrimaryGroups": 7,
      "maxPrimaryNodes": 12,
      "required": "README",
      "mustShowOwnershipAndBoundary": true,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "SPLIT_COMPARE": {
      "aspect": "16:9",
      "layout": "left/right contrast",
      "maxItemsPerSide": 4,
      "bestFor": [
        "Same JVM vs Remote",
        "Gateway vs Direct",
        "Before vs CPF"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "JOURNEY_FLOW": {
      "aspect": "16:9",
      "layout": "timeline/journey",
      "maxStages": 7,
      "exceptionLane": "below",
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "RECOVERY_STATE_MAP": {
      "aspect": "16:9",
      "layout": "state ribbon + recovery branch",
      "maxStates": 7,
      "requiredLabelsWhenRelevant": [
        "UNKNOWN",
        "Reconcile"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "BATCH_CONTROL_EXECUTION_MAP": {
      "aspect": "16:9",
      "layout": "control plane over execution plane",
      "requiredNodes": [
        "Control Plane",
        "Scheduler",
        "Worker",
        "Center-Cut",
        "Agent"
      ],
      "showLeaseBoundary": true,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "LIFECYCLE_PIPELINE": {
      "aspect": "16:9",
      "layout": "numbered pipeline",
      "maxStages": 7,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "OPERATIONS_TRACE": {
      "aspect": "16:9",
      "layout": "multi-lane timeline",
      "lanes": [
        "transactionId",
        "operationId",
        "instanceId",
        "Log/Trace/Timeline"
      ],
      "maxLanes": 5,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "CAPABILITY_LANDSCAPE": {
      "aspect": "16:9",
      "layout": "grouped landscape, not equal cards",
      "groupsMax": 6,
      "itemsPerGroupMax": 5,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "DECISION_MAP": {
      "aspect": "16:9",
      "layout": "branching decision",
      "maxDecisionNodes": 5,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "OWNERSHIP_BOUNDARY": {
      "aspect": "16:9",
      "layout": "nested/layered boundaries",
      "containersMax": 6,
      "dependencyArrowSingleDirection": true,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "ARCHITECTURE_TOPOLOGY": {
      "aspect": "16:9",
      "layout": "layered architecture map",
      "maxPrimaryNodes": 12,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "REQUEST_FLOW": {
      "aspect": "16:9",
      "layout": "journey/sequence",
      "maxStages": 7,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "STATE_TRANSITION": {
      "aspect": "16:9",
      "layout": "state ribbon + recovery branch",
      "maxStates": 7,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "LIFECYCLE": {
      "aspect": "16:9",
      "layout": "numbered pipeline",
      "maxStages": 7,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "OPERATION_TRACE": {
      "aspect": "16:9",
      "layout": "multi-lane timeline",
      "maxLanes": 5,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "DECISION_FLOW": {
      "aspect": "16:9",
      "layout": "branching decision",
      "maxDecisionNodes": 5,
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "DB3_LIFECYCLE": {
      "aspect": "16:9",
      "layout": "pipeline with three vendor bands",
      "vendorBands": [
        "Oracle",
        "PostgreSQL",
        "MariaDB"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate",
      "vendorLabelRule": "Oracle/PostgreSQL/MariaDB labels use equal visual weight, same baseline, same font size, explicit horizontal or vertical lanes; no overlap with DATA/EXTERNAL group title.",
      "groupTitleRule": "DATA/EXTERNAL or DB group title occupies separate title band; vendor labels begin below title band with >=18px gap."
    },
    "BATCH_TOPOLOGY": {
      "aspect": "16:9",
      "layout": "control plane over execution plane",
      "requiredNodes": [
        "Control Plane",
        "Scheduler",
        "Worker",
        "Center-Cut",
        "Agent"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "BATCH_RECOVERY": {
      "aspect": "16:9",
      "layout": "four-way recovery decision",
      "requiredLabels": [
        "Restart",
        "Rerun",
        "Reprocess",
        "Reconcile"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "GENERATOR_FLOW": {
      "aspect": "16:9",
      "layout": "numbered pipeline",
      "requiredStages": [
        "Domain Input",
        "Generator",
        "Generated Domain",
        "Starter/DB",
        "Build/Test"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "GATEWAY_OPTIONALITY": {
      "aspect": "16:9",
      "layout": "split compare",
      "requiredPaths": [
        "외부 Client → Gateway → Target Domain (Gateway 선택 시)",
        "외부/내부 허용 Direct Path (Gateway 미선택 시)",
        "Internal Domain A → Domain Invocation → Domain B (Gateway 미경유)"
      ],
      "mustNotDepictAutomaticFallback": true,
      "internalDomainToDomainViaGateway": "forbidden",
      "requiredKoreanExplanation": "그림 아래 1~2문장으로 Gateway 선택 기준과 내부 Domain 호출 비경유 원칙을 설명",
      "contrastGate": "all required labels >= 4.5:1",
      "commonGeometryGateRef": "$.commonGeometryGate"
    },
    "SECURITY_AUDIT_FLOW": {
      "aspect": "16:9",
      "layout": "journey/approval trail",
      "requiredConcepts": [
        "Identity",
        "Permission",
        "Approval",
        "Audit"
      ],
      "commonGeometryGateRef": "$.commonGeometryGate"
    }
  },
  "commonGeometryGate": {
    "nodeInnerPaddingPxMin": 18,
    "labelGapPxMin": 20,
    "nodeGapPxMin": 24,
    "labelConnectorClearancePxMin": 12,
    "groupTitleBandPxMin": 44,
    "labelLinesHardMax": 2,
    "textBoundaryCollisionAllowed": 0,
    "textConnectorCollisionAllowed": 0,
    "groupTitleChildOverlapAllowed": 0,
    "parallelLabelBaselineDriftAllowed": 0,
    "forcedTinyText": "forbidden",
    "visualBalance": "required; no accidental one-side crowding or dead space"
  }
}
