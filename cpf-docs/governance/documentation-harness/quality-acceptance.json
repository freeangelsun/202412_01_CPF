{
  "schemaVersion": "2.0",
  "harnessVersion": "2.4.0",
  "locked": true,
  "purpose": "자동 규칙 존재 확인과 실제 문서 품질 승인을 분리하고, 승인된 품질을 다음 수정의 회귀 기준으로 사용한다.",
  "approvalStates": {
    "DRAFT": "작성 중. 기준선 아님.",
    "AUTOMATED_PASS_ONLY": "정적/구조 Validator만 통과. 품질 승인 아님. 보존 기준선으로 사용 금지.",
    "VISUAL_QA_APPROVED": "전페이지 Render와 수동 시각 평가를 통과. 보존 기준선 가능.",
    "USER_APPROVED": "사용자가 명시적으로 품질을 승인. 최우선 보존 기준선.",
    "REJECTED": "사용자 또는 Visual QA에서 결함 발견. 보존 기준선 금지.",
    "SUPERSEDED": "더 최신 승인본으로 대체됨.",
    "BASELINE_REJECTED": "사용자가 기존 공식 산출물 전체를 품질 기준 미달로 판정. 최초 1회 Fresh Rebuild 허용 상태이며 보존 기준선 금지.",
    "INITIAL_FRESH_REBUILD": "BASELINE_REJECTED에서 사용자 명시 요청으로 수행하는 최초 1회 재구축. 완료 전 기준선 아님."
  },
  "baselineEligibility": [
    "USER_APPROVED",
    "VISUAL_QA_APPROVED"
  ],
  "automatedPassIsQualityPass": false,
  "stages": [
    {
      "id": "HARNESS_SCHEMA_PASS",
      "automated": true,
      "required": true,
      "meaning": "Harness 구조/Lock/Profile/정본 규칙 일치"
    },
    {
      "id": "ARTIFACT_STRUCTURE_PASS",
      "automated": true,
      "required": true,
      "meaning": "필수 Artifact/Link/Source/형식 규칙"
    },
    {
      "id": "READER_TASK_FIT_PASS",
      "automated": false,
      "required": true,
      "meaning": "Persona가 실제 질문/작업/판단을 문서에서 완료할 수 있음"
    },
    {
      "id": "TABLE_SEMANTIC_FIT_PASS",
      "automated": false,
      "required": true,
      "meaning": "표 사용 자체와 Column 폭/균등 여부가 실제 데이터 구조에 적합하며 Header Wrap 0"
    },
    {
      "id": "HEADING_AND_VERTICAL_RHYTHM_PASS",
      "automated": false,
      "required": true,
      "meaning": "대제목/H1 한 줄 우선, 고립 Wrap 0, 대메뉴와 의미 단위 전환의 breathing room 충족"
    },
    {
      "id": "EMBEDDED_FIGURE_PASS",
      "automated": false,
      "required": true,
      "meaning": "원본 Figure뿐 아니라 README/DOCX/PDF 삽입 후 경계·Crop·의미 완결성 PASS"
    },
    {
      "id": "RENDER_TECHNICAL_PASS",
      "automated": false,
      "required": true,
      "meaning": "DOCX/PDF/README 실제 Render, glyph/crop/overflow/font/link 기술 검증"
    },
    {
      "id": "FIGURE_GEOMETRY_PASS",
      "automated": true,
      "required": true,
      "meaning": "Figure bounding box/frame/safe area/overlap geometry manifest PASS"
    },
    {
      "id": "HUMAN_VISUAL_PASS",
      "automated": false,
      "required": true,
      "meaning": "페이지별 시각 품질 평가. Contact sheet만으로 대체 금지"
    },
    {
      "id": "REGRESSION_PASS",
      "automated": false,
      "required": true,
      "meaning": "변경 영향 범위의 승인 기준선 대비 퇴행 0"
    },
    {
      "id": "CLICK_THROUGH_PASS",
      "automated": false,
      "required": true,
      "meaning": "PDF Navigation 실제 Target + 사용자 DOCX 링크 0 확인"
    },
    {
      "id": "PACKAGE_REPLAY_PASS",
      "automated": true,
      "required": true,
      "meaning": "최종 ZIP Clean Replay/Hash/Path/Garbage 검증"
    },
    {
      "id": "PROVENANCE_ISOLATION_PASS",
      "type": "AUTOMATED_AND_MANUAL",
      "required": true,
      "pass": "사용자 본문/표/도입부에 Harness version, Source SHA/ZIP, 제작 baseline을 노출하지 않음"
    },
    {
      "id": "OPENING_SUMMARY_PASS",
      "type": "MANUAL",
      "required": true,
      "pass": "문서 첫 화면이 자연스러운 1~2문장 lead로 독자·목적·완료 결과를 설명하며 메타정보 표를 사용하지 않음"
    },
    {
      "id": "CONNECTOR_BOUNDARY_PASS",
      "type": "AUTOMATED_AND_MANUAL",
      "required": true,
      "pass": "모든 Connector가 target Box 외곽 경계에서 종료되고 target interior 침범 0"
    },
    {
      "id": "CONTRAST_AND_NON_TEXT_PASS",
      "type": "AUTOMATED_AND_MANUAL",
      "required": true,
      "pass": "Text 4.5:1/large 3:1 및 의미 그래픽 3:1, color-only meaning 0"
    },
    {
      "id": "NEGATIVE_FIXTURE_PASS",
      "type": "AUTOMATED",
      "required": true,
      "pass": "quality-fixtures.json의 모든 FAIL fixture를 Validator가 거부"
    },
    {
      "id": "HUMAN_READER_PASS",
      "type": "MANUAL",
      "required": true,
      "pass": "대상 독자 관점에서 문서 목적/다음 행동/그림 의미가 빠르게 식별됨"
    },
    {
      "id": "SOURCE_ZIP_COMPLETENESS_PASS",
      "type": "AUTOMATED",
      "required": true,
      "pass": "README/guides/deliverables/assets/harness/cpf-tools-build 강제 포함 및 DOCX11/PDF11/Visual/Harness count 검증"
    }
  ],
  "manualVisualScore": {
    "scale": "1..5",
    "minimumEach": 4,
    "minimumAverage": 4.4,
    "dimensions": [
      "hierarchy_and_scanability",
      "vertical_rhythm",
      "horizontal_hierarchy_and_content_rail",
      "page_visual_balance",
      "visual_grammar_appropriateness",
      "figure_readability",
      "figure_caption_ownership",
      "table_readability",
      "content_density_and_breathing_room",
      "first_scan_comprehension",
      "consistency",
      "professional_polish",
      "component_choice_fit",
      "table_column_proportion",
      "heading_line_integrity",
      "reader orientation",
      "connector cleanliness",
      "table semantic fitness",
      "provenance isolation"
    ],
    "criticalZeroRequired": [
      "text_overlap",
      "text_or_shape_crop",
      "broken_glyph",
      "figure_boundary侵범",
      "connector_text_collision",
      "wrong_pdf_docx_link",
      "ambiguous_figure_explanation",
      "dark_on_dark_primary_visual",
      "isolated_orphan_block",
      "unintended_dead_page",
      "frame_outside_canvas",
      "bottom_safe_area_violation",
      "annotation_clearance_violation",
      "generic_figure_explanation_label",
      "docx_link_in_user_navigation",
      "developer_api_option_summary_missing",
      "table_header_wrap",
      "non_tabular_content_in_table",
      "unjustified_equal_width",
      "unjustified_fixed_50_50",
      "meaningless_repeated_column",
      "major_heading_orphan_wrap",
      "section_transition_crowding",
      "embedded_figure_boundary_intrusion",
      "semantically_incomplete_visual"
    ],
    "rule": "평균이 높아도 Critical 결함 1건이면 FAIL. 모든 Dimension 4 이상이어야 한다."
  },
  "regression": {
    "scope": "변경된 페이지/블록 + 인접 영향 페이지",
    "unchangedApprovedArea": "byte/layout preservation preferred; 이유 없는 변경 금지",
    "scoreRegression": "기준선보다 한 Dimension이라도 낮아지면 원인 기록 후 수정 또는 사용자 승인 필요",
    "visualDiffRequired": true,
    "beforeAfterEvidenceRequired": true
  },
  "completionRule": "AUTOMATED_PASS_ONLY 상태로 최종 완료를 선언하지 않는다. HUMAN_VISUAL_PASS와 REGRESSION_PASS 없이는 완료가 아니다.",
  "initialRebuildLifecycle": {
    "entryState": "BASELINE_REJECTED",
    "allowedAction": "INITIAL_FRESH_REBUILD",
    "requiresUserExplicitRequest": true,
    "candidateState": "GOLDEN_BASELINE_CANDIDATE",
    "approvalStates": [
      "VISUAL_QA_APPROVED",
      "USER_APPROVED"
    ],
    "afterApproval": "PATCH_ONLY",
    "secondFreshRewriteWithoutNewExplicitRejection": "FORBIDDEN"
  },
  "falseGreenRule": "Automated PASS cannot override a user-visible defect. Any user-visible defect makes the affected artifact FAIL until the Harness rule/fixture and artifact are both corrected."
}
