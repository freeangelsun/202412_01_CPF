{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CPF Documentation Profile",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "harnessVersion",
    "documentId",
    "title",
    "locked",
    "changeAuthority",
    "structureLocked",
    "sections"
  ],
  "properties": {
    "locked": {
      "const": true
    },
    "changeAuthority": {
      "const": "USER_EXPLICIT_REQUEST_ONLY"
    },
    "structureLocked": {
      "const": true
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "title",
          "model",
          "requiredH2",
          "additionalH2",
          "additionalH3",
          "tables",
          "figures",
          "maxCodeLevel"
        ],
        "properties": {
          "additionalH2": {
            "const": false
          },
          "additionalH3": {
            "const": false
          },
          "requiredH2": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
