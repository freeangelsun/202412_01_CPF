{
  "schemaVersion": "2.0",
  "harnessVersion": "2.15.1",
  "required": [
    "asset",
    "canvas",
    "objects",
    "connectors",
    "embeddedRenders"
  ],
  "objectRequired": [
    "id",
    "kind",
    "x",
    "y",
    "w",
    "h"
  ],
  "kinds": [
    "frame",
    "container",
    "node",
    "text",
    "annotation",
    "connectorLabel",
    "junction"
  ],
  "connectorRequired": [
    "id",
    "from",
    "to",
    "points",
    "targetBoundaryPoint",
    "arrowhead"
  ],
  "rules": {
    "insideCanvas": true,
    "noForbiddenOverlap": true,
    "safeMarginPxMin": 64,
    "bottomSafeZonePxMin": 64,
    "annotationGapPxMin": 28,
    "nodeInnerPaddingPxMin": 28,
    "labelConnectorClearancePxMin": 20,
    "connectorRouteMustAvoidText": true,
    "connectorRouteMustAvoidUnrelatedNodeInterior": true,
    "connectorTargetBoundaryTermination": true,
    "connectorEndpointBoundaryTolerancePx": 2,
    "connectorTargetInteriorPenetrationPxMax": 0,
    "arrowheadBodyInsideTargetPxMax": 0,
    "connectorEmptySpaceTermination": "forbidden unless labeled junction",
    "meaningfulGraphicContrastMin": "3:1",
    "normalTextContrastMin": "4.5:1",
    "colorOnlyMeaning": "forbidden",
    "embeddedEffectiveTextPtMin": 10.5,
    "coarseContainerOnlyManifest": "forbidden"
  },
  "embeddedRenderRequiredFields": [
    "surface",
    "displayWidthPx",
    "displayHeightPx",
    "effectiveMinTextPt",
    "crop",
    "boundaryIntrusion",
    "contrastPass"
  ]
}
