{
  "schemaVersion": "1.0",
  "harnessVersion": "1.1.3",
  "locked": true,
  "changeAuthority": "USER_EXPLICIT_REQUEST_ONLY",
  "renderMatrix": {
    "README": [
      {
        "viewport": "1440x900",
        "theme": "light"
      },
      {
        "viewport": "1440x900",
        "theme": "dark"
      },
      {
        "viewport": "390x844",
        "theme": "light"
      },
      {
        "viewport": "390x844",
        "theme": "dark"
      }
    ],
    "DOCX": "11 documents; render all to PDF with final fonts and field updates",
    "PDF": "11 documents; render every page to PNG or equivalent for visual inspection"
  },
  "hardFail": {
    "croppedText": 0,
    "croppedImage": 0,
    "textImageOverlap": 0,
    "figureLabelOverlap": 0,
    "tableClip": 0,
    "brokenGlyph": 0,
    "brokenKorean": 0,
    "brokenLink": 0,
    "brokenImageLink": 0,
    "nonCodeCenterAlignedTableBodyCells": 0,
    "mechanicalEqualWidthTables": 0,
    "blankPages": 0,
    "headingOnlyPages": 0,
    "manualDecorativeLineBreaksCausingRaggedTables": 0,
    "fontSubstitutionInFinalPdf": 0,
    "raggedIndentation": 0,
    "untitledTables": 0,
    "untitledFigures": 0,
    "longProseTableCells": 0,
    "repeatedGenericDiagramTemplate": 0,
    "readmeToc": 0,
    "readmeUnnumberedH1": 0
  },
  "reviewTriggers": {
    "pageDensityBelowPct": 35,
    "tableHasMoreThanColumnsPortrait": 4,
    "tableHasMoreThanColumnsLandscape": 5,
    "sentenceKoreanCharsOver": 65,
    "paragraphSentencesOver": 3,
    "listItemsOver": 5,
    "readmeImageTextPxBelow": 28,
    "docFigureTextPtBelow": 10,
    "tableFontPtBelow": 9.0,
    "tableCellKoreanCharsOver": 70,
    "tableCellVisualLinesOver": 4
  },
  "mandatoryInspection": {
    "allPagesQuickScan": true,
    "fullSizePages": [
      "cover",
      "toc",
      "first content page",
      "every page with a figure",
      "every page with a wide table",
      "every code-heavy page",
      "every page where table crosses page boundary",
      "last page"
    ],
    "figureInspection": [
      "100%",
      "200% for labels/boundaries",
      "check Korean/English glyph",
      "check dark/light contrast",
      "check caption matches figure",
      "check figure not duplicating prose verbatim",
      "visual type differs from adjacent visual",
      "information hierarchy/polish",
      "actual architecture/boundary fidelity"
    ],
    "tableInspection": [
      "actual Word tblGrid",
      "cell width",
      "header alignment",
      "body alignment",
      "wrap",
      "row page split",
      "repeat header",
      "font size",
      "padding",
      "table number/title/purpose",
      "cell prose length",
      "column count",
      "body left grid alignment"
    ]
  },
  "fixLoop": [
    "collect all failures",
    "group by root cause",
    "apply global token/profile fix where applicable",
    "regenerate all impacted documents",
    "rerender",
    "repeat full high-risk checks",
    "only then mark VISUAL_PASS"
  ],
  "passDefinition": "Visual PASS는 1) 전페이지 실제 렌더, 2) 표/그림/들여쓰기 Grid의 통일, 3) README 대표 Architecture 구성도와 시각화 다양성, 4) 장황한 표/반복 도식 0을 모두 만족한 상태다."
}
