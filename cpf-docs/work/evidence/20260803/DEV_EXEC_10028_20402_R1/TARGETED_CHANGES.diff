+    else:
+        print(f"GENERATOR_JAVA_TEMPLATE_PROFILE=PASS profile={profile} sources={count} release=21")
+
+if failures:
+    for failure in failures:
+        print(failure)
+    print(f"GENERATOR_JAVA_TEMPLATE_COMPILE=FAIL profiles=2 sources={total_sources} release=21")
+    raise SystemExit(1)
