        403
      ],
      "attack": {
        "vector": "fake-semantic-ssrf"
      },
      "assertion": {
        "boundary": "fake-not-cpf"
      },
      "attackPayload": "http://169.254.169.254/latest/meta-data"
    },
    {
      "id": "fake-idor",
