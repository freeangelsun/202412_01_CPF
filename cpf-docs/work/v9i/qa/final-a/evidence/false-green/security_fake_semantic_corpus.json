      ],
      "attack": {
        "vector": "fake-tamper",
        "tamperedField": "amount",
        "originalDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "assertion": {
        "boundary": "fake-not-cpf",
        "integrityRejected": true
      }
