{
  "schemaVersion": 2,
  "cases": [
    {
      "id": "fake-xss",
      "category": "xss",
      "kind": "http",
      "url": "http://127.0.0.1:18767/security",
      "method": "POST",
      "expected_statuses": [
        403
      ],
      "attack": {
        "vector": "fake-semantic-xss"
      },
      "assertion": {
        "boundary": "fake-not-cpf"
      },
      "attackPayload": "<script>alert(1)</script>"
    },
    {
      "id": "fake-csrf",
      "category": "csrf",
      "kind": "http",
      "url": "http://127.0.0.1:18767/security",
      "method": "POST",
      "expected_statuses": [
        403
      ],
      "attack": {
        "vector": "fake-semantic-csrf"
      },
      "assertion": {
        "boundary": "fake-not-cpf",
        "stateUnchanged": true
      },
      "headers": {
        "Origin": "https://evil.example"
      },
      "body": "x=1"
    },
    {
      "id": "fake-ssrf",
      "category": "ssrf",
      "kind": "http",
      "url": "http://127.0.0.1:18767/security",
