  "moduleName": "Member",
  "displayName": "Member",
  "domainIdCode": "MBR",
  "packageName": "com.cpf.member",
  "basePackage": "com.cpf.member",
  "schemaName": "mbrDB",
  "port": 8081,
  "tablePrefix": "mbr",
  "sampleTable": "mbr_sample_item",
  "idempotencyLedgerTable": "mbr_sample_item_idem",
  "onlineEnabled": true,
  "databaseEnabled": true,
  "databaseVendor": "mariadb",
  "databaseVendorProperty": "cpf.db.vendor",
  "databaseProfilePath": "deploy/database/database-profile.json",
  "databaseConnectionDefaults": {
    "vendor": "mariadb",
    "host": "127.0.0.1",
    "port": 3306,
    "databaseName": "mbrDB",
    "schemaName": "mbrDB",
    "adminUsername": "root",
    "migrationUsername": "cpf_member_migration",
    "runtimeUsername": "cpf_member_app"
  },
  "supportedDatabaseVendors": ["mariadb","oracle","postgresql"],
  "databaseTemplatePack": "cpf-tools/db/vendor/{vendor}/domain-template",
  "databaseTemplateSelector": {
    "vendor": "mariadb",
    "metadata": "manifest/domain-manifest.json",
    "sourceTreeMutation": false,
    "selectedVendorOnly": true
  },
  "databaseResourceAssembly": "prepareCpfVendorResources",
  "databaseLifecycle": {
    "sourceOfTruth": "cpf-tools/db/vendor/{vendor}/domain-template",
    "bootstrapScript": "cpf-tools/scripts/initialize-domain-database.ps1",
    "defaultSampleTable": "mbr_sample_item",
    "idempotencyLedgerTable": "mbr_sample_item_idem",
    "transactionIdentity": "transactionId"
  },
  "generatedResourceRoot": "build/generated-resources/cpf-vendor",
  "dependencyModel": "root-project",
  "platformVersion": "1.0.0-SNAPSHOT",
  "templateContractVersion": "1.2",
  "dataSourceJndiName": "java:comp/env/jdbc/cpfMemberDataSource",
  "batchEnabled": false,
  "centerCutEnabled": false,
  "externalEnabled": false,
  "messagingEnabled": false,
  "fileEnabled": false,
  "securityAuditEnabled": false,
  "uiEnabled": false,
  "bzaMenuEnabled": false,
  "productionProfileEnabled": false,
  "capabilities": {
    "online": true,
    "database": true,
    "batch": false,
    "centerCut": false,
    "external": false,
    "messaging": false,
    "file": false,
    "securityAudit": false,
    "ui": false,
    "bzaMenu": false,
    "productionProfile": false
  },
  "physicalTableContract": {
    "totalTables": 2,
    "businessTableCount": 1,
    "supportLedgerCount": 1,
    "additionalTablesAllowed": false
  },
  "runtimeAgent": {
    "enabledByDefault": false,
    "activationProfile": "runtime-agent",
    "applicationConfig": "src/main/resources/application-runtime-agent.yml",
    "deploymentDescriptor": "deploy/runtime/runtime-agent.json",
    "capabilityDiscovery": "CpfRuntimeChangeApplier",
    "requiredEnvironment": [
      "CPF_RUNTIME_INSTANCE_ID",
      "CPF_RUNTIME_SERVICE_ID",
      "CPF_RUNTIME_ENDPOINT_CODE",
      "CPF_RUNTIME_BASE_URL",
      "CPF_RUNTIME_CONTROL_BASE_URL",
      "CPF_RUNTIME_CONTROL_AGENT_TOKEN"
    ],
    "failClosed": true
  },
  "serviceRegistration": {
    "candidate": true,
    "serviceId": "MBR",
    "ownerModule": "cpf-member",
    "environmentBinding": "runtime-profile",
    "directAllowedByDefault": true,
    "gatewayAllowedByDefault": false,
    "endpoints": [
      {
        "enabled": true,
        "endpointCode": "MBR_ONLINE",
        "protocol": "HTTP",
        "basePath": "/api/member",
        "healthMethod": "HTTP",
        "healthPath": "/actuator/health/readiness",
        "contractVersion": "1.0"
      }
    ]
  },
  "parameterSchemas": {
    "contract": "com.cpf.core.api.parameter.CpfParameterSchema",
    "schemaVersion": "1.0",
    "runtimeOverrideDefault": false,
    "secretReferenceOnly": true
  },
  "gatewayBindingDefaults": {
    "externalExposure": "DENY",
    "approvalRequired": true,
    "connectionTestRequired": true,
    "healthValidationRequired": true
  },
  "serviceId": "MBR",
  "onlineStandardId": "OMBRQY0001",
  "batchStandardId": "BMBRTS0001",
  "minimalTransactionContract": {
    "model": "sample-item",
    "tableRole": "business-sample",
    "logicalTable": "mbrDB.mbr_sample_item",
    "requiredColumns": ["sample_item_id","sample_key","item_name","status_code","version_no","idempotency_key","transaction_id","transaction_sequence","transaction_at","deleted_yn","created_by","created_at","updated_by","updated_at"],
    "transactionIdWidth": 34,
    "requiredKeys": ["primary-key","sample-key-unique"],
    "requiredIndexes": ["idempotency-key-audit","status-deleted-id","transaction-id-sequence"],
    "requiredChecks": ["status-active-inactive","deleted-yn"],
    "operations": ["create","read","update","delete","search","offset-page","slice","cursor","validation","transaction-commit","transaction-rollback","optimistic-lock","duplicate","local-call","remote-call","standard-header","transaction-id","error-mapping","idempotency","audit","masking","framework-edu"]
  },
  "idempotencyLedgerContract": {
    "model": "sample-item-idempotency-ledger",
    "tableRole": "non-business-support-ledger",
    "logicalTable": "mbrDB.mbr_sample_item_idem",
    "requiredColumns": ["idempotency_key","operation_code","request_hash","sample_item_id","result_version","deleted_yn","transaction_id","created_at"],
    "transactionIdWidth": 34,
    "requiredKeys": ["primary-key","sample-item-foreign-key"],
    "requiredIndexes": ["sample-item-created-at","transaction-id-created-at"],
    "requiredChecks": ["operation-create-update-delete","deleted-yn"],
    "replayPolicy": "same-key-and-request-hash-replay-different-hash-conflict",
    "logicalDeleteReplayRequired": true
  }
}