{
  "profileVersion": 1,
  "profileName": "local-dev",
  "environment": "development",
  "description": "Git-tracked CPF local development DB install profile. Every platform module owns an independent DB connection profile. EXS is not a fixed platform module; create external/EXS with the Golden Generated Domain generator when required.",
  "supportedVendors": [
    "mariadb",
    "mysql",
    "postgresql",
    "oracle",
    "sqlserver"
  ],
  "policy": {
    "promptForMissingValues": false,
    "allowInlineDevDefaults": true,
    "failClosedOnMissingVendorPack": true,
    "failClosedOnPartialDatabase": true,
    "autoDropDatabase": false,
    "autoResetDatabase": false,
    "allowMixedVendorConfiguration": true,
    "allowMixedHostConfiguration": true
  },
  "modules": {
    "core": {
      "domainName": "core",
      "systemCode": "CPF",
      "moduleName": "cpf-core",
      "enabled": true,
      "required": true,
      "transitional": false,
      "logicalDatabase": "cpfDB",
      "vendor": "mariadb",
      "host": "127.0.0.1",
      "port": 3306,
      "databaseName": "cpfDB",
      "schemaName": "cpfDB",
      "clientPath": "C:/dev/DB/MariaDB 12.3/bin/mariadb.exe",
      "admin": {
        "username": "root",
        "userHost": "%",
        "password": {
          "env": "CPF_CPF_DB_ADMIN_PASSWORD",
          "fallbackEnv": "CPF_DB_ROOT_PASSWORD"
        }
      },
      "migration": {
        "username": "cpf_migration",
        "userHost": "%",
        "password": {
          "env": "CPF_CPF_DB_MIGRATION_PASSWORD",
          "fallbackEnv": "CPF_DB_MIGRATION_PASSWORD",
          "devDefault": "CpfCPFMig#2026"
        }
      },
      "runtime": {
        "username": "cpf_app",
        "userHost": "%",
        "password": {
          "env": "CPF_CPF_DB_RUNTIME_PASSWORD",
          "fallbackEnv": "CPF_DB_APP_PASSWORD",
          "devDefault": "CpfCPFApp#2026"
        }
      },
      "seed": {
        "product": true,
        "optionalSample": false,
        "test": false
      }
    },
