{
  "profileVersion": 1,
  "profileName": "production-template",
  "environment": "production",
  "description": "Production template. Replace host/database/schema/account names and provide passwords only through environment or an external secret provider. EXS is not a fixed platform module; create external/EXS with the Golden Generated Domain generator when required.",
  "supportedVendors": [
    "mariadb",
    "postgresql",
    "oracle"
  ],
  "policy": {
    "promptForMissingValues": false,
    "allowInlineDevDefaults": false,
    "failClosedOnMissingVendorPack": true,
    "failClosedOnPartialDatabase": true,
    "autoDropDatabase": false,
    "autoResetDatabase": false,
    "allowMixedVendorConfiguration": true,
    "allowMixedHostConfiguration": true
  },
  "modules": {
    "core": {
      "domainName": "core",
      "systemCode": "CPF",
      "moduleName": "cpf-core",
      "enabled": true,
      "required": true,
      "transitional": false,
      "logicalDatabase": "cpfDB",
      "vendor": "mariadb",
      "host": "${CPF_DB_HOST}",
      "port": 0,
      "databaseName": "cpfDB",
      "schemaName": "cpfDB",
      "clientPath": "",
      "sslMode": "verify-full",
      "admin": {
        "username": "root",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_ADMIN_PASSWORD",
          "fallbackEnv": "CPF_DB_ROOT_PASSWORD"
        }
      },
      "migration": {
        "username": "cpf_migration",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_MIGRATION_PASSWORD",
          "fallbackEnv": "CPF_DB_MIGRATION_PASSWORD"
        }
      },
      "runtime": {
        "username": "cpf_app",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_RUNTIME_PASSWORD",
          "fallbackEnv": "CPF_DB_APP_PASSWORD"
        }
      },
      "seed": {
        "product": true,
        "optionalSample": false,
        "test": false
      }
    },
