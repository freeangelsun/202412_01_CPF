  "forbiddenPatterns": [
    {
      "id": "DYNAMIC_GRADLE_VERSION",
      "regex": "(?:[\"'](?:latest\\.(?:release|integration)|[^\"']*\\+)[\"'])",
      "extensions": [
        ".gradle",
        ".kts"
      ]
    },
    {
      "id": "UNBOUNDED_READ_ALL_BYTES",
      "regex": "\\breadAllBytes\\s*\\(",
      "extensions": [
        ".java",
        ".kt"
      ]
    },
    {
      "id": "LEGACY_HASH_ROUTER",
      "regex": "location\\.hash|hashchange",
      "extensions": [
        ".ts",
        ".js",
        ".mjs",
        ".vue"
      ]
    },
    {
      "id": "BROWSER_TOKEN_STORAGE",
      "regex": "localStorage\\.(?:setItem|getItem)\\([^\\n]*(?:token|access|refresh)",
      "extensions": [
        ".ts",
        ".js",
        ".mjs",
        ".vue"
      ]
    },
    {
      "id": "CUSTOM_MIGRATION_EXECUTOR",
      "regex": "(?:class|interface)\\s+(?:Cpf)?(?:Schema|Sql|Database)?MigrationExecutor\\b",
      "extensions": [
        ".java",
        ".kt"
      ]
    },
    {
      "id": "POWERSHELL_POLICY_BYPASS",
      "regex": "-ExecutionPolicy(?:\\s+|[\"']?\\s*,\\s*[\"']?)Bypass\\b",
      "extensions": [
        ".gradle",
        ".kts",
        ".groovy",
        ".ps1",
        ".py",
        ".yml",
        ".yaml"
      ]
    }
