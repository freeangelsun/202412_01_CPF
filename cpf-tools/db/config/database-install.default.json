{
  "profileVersion": 1,
  "profileName": "local-dev",
  "environment": "development",
  "description": "CPF DB connection/lifecycle profile. CPF/CMN/ADM/BAT share CPF_PLATFORM_DB(cpfDB); Backoffice(MBW) uses mbwDB as its CUSTOMER_BUSINESS_DB development target; cpf-education may consume the DB Tool-owned non-production REFERENCE_FIXTURE. enabled means an independent DB lifecycle target, not application enablement.",
  "supportedVendors": [
    "mariadb",
    "postgresql",
    "oracle"
  ],
  "policy": {
    "promptForMissingValues": false,
    "allowInlineDevDefaults": false,
    "failClosedOnMissingVendorPack": true,
    "failClosedOnPartialDatabase": true,
    "autoDropDatabase": false,
    "autoResetDatabase": false,
    "allowMixedVendorConfiguration": false,
    "allowMixedHostConfiguration": true
  },
  "modules": {
    "core": {
      "domainName": "core",
      "systemCode": "CPF",
      "moduleName": "cpf-core",
      "enabled": true,
      "required": true,
      "transitional": false,
      "logicalDatabase": "cpfDB",
      "vendor": "mariadb",
      "host": "127.0.0.1",
      "port": 3306,
      "databaseName": "cpfDB",
      "schemaName": "cpfDB",
      "clientPath": "C:/dev/DB/MariaDB 12.3/bin/mariadb.exe",
      "sslMode": "disabled",
      "admin": {
        "username": "root",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_ADMIN_PASSWORD",
          "fallbackEnv": "CPF_DB_ROOT_PASSWORD"
        }
      },
      "migration": {
        "username": "cpf_migration",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_MIGRATION_PASSWORD",
          "fallbackEnv": "CPF_DB_MIGRATION_PASSWORD"
        }
      },
      "runtime": {
        "username": "cpf_app",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_RUNTIME_PASSWORD",
          "fallbackEnv": "CPF_DB_APP_PASSWORD"
        }
      },
      "seed": {
        "product": true,
        "optionalSample": false,
        "test": false
      }
    },
