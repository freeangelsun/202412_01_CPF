{
  "profileVersion": 1,
  "profileName": "production-template",
  "environment": "production",
  "description": "CPF DB connection/lifecycle profile. CPF/CMN/ADM/BAT share CPF_PLATFORM_DB(cpfDB); BZA uses bzaDB; cpf-education may consume the DB Tool-owned non-production REFERENCE_FIXTURE. enabled means an independent DB lifecycle target, not application enablement.",
  "supportedVendors": [
    "mariadb",
    "postgresql",
    "oracle"
  ],
  "policy": {
    "promptForMissingValues": false,
    "allowInlineDevDefaults": false,
    "failClosedOnMissingVendorPack": true,
    "failClosedOnPartialDatabase": true,
    "autoDropDatabase": false,
    "autoResetDatabase": false,
    "allowMixedVendorConfiguration": true,
    "allowMixedHostConfiguration": true
  },
  "modules": {
    "core": {
      "domainName": "core",
      "systemCode": "CPF",
      "moduleName": "cpf-core",
      "enabled": true,
      "required": true,
      "transitional": false,
      "logicalDatabase": "cpfDB",
      "vendor": "mariadb",
      "host": "${CPF_DB_HOST}",
      "port": 0,
      "databaseName": "cpfDB",
      "schemaName": "cpfDB",
      "clientPath": "",
      "sslMode": "verify-full",
      "admin": {
        "username": "root",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_ADMIN_PASSWORD",
          "fallbackEnv": "CPF_DB_ROOT_PASSWORD"
        }
      },
      "migration": {
        "username": "cpf_migration",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_MIGRATION_PASSWORD",
          "fallbackEnv": "CPF_DB_MIGRATION_PASSWORD"
        }
      },
      "runtime": {
        "username": "cpf_app",
        "userHost": "%",
        "password": {
          "env": "CPF_CORE_DB_RUNTIME_PASSWORD",
          "fallbackEnv": "CPF_DB_APP_PASSWORD"
        }
      },
      "seed": {
        "product": true,
        "optionalSample": false,
        "test": false
      }
    },
    "common": {
      "domainName": "common",
      "systemCode": "CMN",
      "moduleName": "cpf-common",
      "enabled": false,
      "required": false,
