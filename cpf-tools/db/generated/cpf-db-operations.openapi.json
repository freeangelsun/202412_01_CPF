{
  "components": {
    "schemas": {
      "DbOperationEvidence": {
        "additionalProperties": false,
        "properties": {
          "alerts": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "approvalReference": {
            "minLength": 1,
            "type": "string"
          },
          "approvedBy": {
            "minLength": 1,
            "type": "string"
          },
          "capabilityId": {
            "enum": [
              "DB-OWNERSHIP",
              "DB-INSTALL",
              "DB-FRESH",
              "DB-MIGRATION",
              "DB-ROLLBACK",
              "DB-BACKUP",
              "DB-MULTI-VENDOR",
              "DB-SQL",
              "DB-PERF",
              "DB-MULTI",
              "DATA-LINEAGE",
              "DATA-RETENTION"
            ],
            "type": "string"
          },
          "environment": {
            "minLength": 1,
            "type": "string"
          },
          "evidenceSha256": {
            "pattern": "^[0-9a-fA-F]{64}$",
            "type": "string"
          },
          "finishedAt": {
            "format": "date-time",
            "type": "string"
          },
          "health": {
            "$ref": "#/components/schemas/DbOperationHealth"
          },
          "metrics": {
            "$ref": "#/components/schemas/DbOperationMetrics"
          },
          "operationId": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
            "type": "string"
          },
          "operator": {
            "minLength": 1,
            "type": "string"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "reconcileRequired": {
            "type": "boolean"
          },
          "resultStatus": {
            "enum": [
              "PLANNED",
              "RUNNING",
              "SUCCEEDED",
              "FAILED",
              "UNKNOWN",
              "RECONCILED"
            ],
            "type": "string"
          },
          "runbookRef": {
            "minLength": 1,
            "type": "string"
          },
          "sourceSha": {
            "pattern": "^[0-9a-fA-F]{40}$",
            "type": "string"
          },
          "startedAt": {
            "format": "date-time",
            "type": "string"
          },
          "topology": {
            "minLength": 1,
            "type": "string"
          },
          "trace": {
            "$ref": "#/components/schemas/DbOperationTrace"
          },
          "vendor": {
            "enum": [
              "mariadb",
              "postgresql",
              "oracle"
            ],
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "capabilityId",
          "vendor",
          "environment",
          "topology",
          "operator",
          "reason",
          "approvalReference",
          "approvedBy",
          "startedAt",
          "finishedAt",
          "resultStatus",
          "reconcileRequired",
          "sourceSha",
          "evidenceSha256",
          "metrics",
          "trace",
          "health",
          "alerts",
          "runbookRef"
        ],
        "type": "object"
      },
      "DbOperationHealth": {
        "additionalProperties": false,
        "properties": {
          "after": {
            "enum": [
              "UP",
              "DEGRADED",
              "DOWN",
              "UNKNOWN"
            ],
            "type": "string"
          },
          "before": {
            "enum": [
              "UP",
              "DEGRADED",
              "DOWN",
              "UNKNOWN"
            ],
            "type": "string"
          }
        },
        "required": [
          "before",
          "after"
        ],
        "type": "object"
      },
      "DbOperationMetrics": {
        "additionalProperties": false,
        "properties": {
          "affectedRows": {
            "minimum": 0,
            "type": "number"
          },
          "durationMs": {
            "minimum": 0,
            "type": "number"
          },
          "errorCount": {
            "minimum": 0,
            "type": "number"
          },
          "retryCount": {
            "minimum": 0,
            "type": "number"
          }
        },
        "required": [
          "durationMs",
          "affectedRows",
          "errorCount",
          "retryCount"
        ],
        "type": "object"
      },
      "DbOperationTrace": {
        "additionalProperties": false,
        "properties": {
          "spanId": {
            "pattern": "^[0-9a-fA-F]{16}$",
            "type": "string"
          },
          "traceId": {
            "pattern": "^[0-9a-fA-F]{16,32}$",
            "type": "string"
          }
        },
        "required": [
          "traceId",
          "spanId"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "CPF DB Operations Provider Contract",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/cpf/db/operations/verify": {
      "post": {
        "operationId": "verifyCpfDbOperationEvidence",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DbOperationEvidence"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DbOperationEvidence"
                }
              }
            },
            "description": "Validated evidence"
          },
          "400": {
            "description": "Invalid or incomplete evidence"
          },
          "403": {
            "description": "Authorization or separation-of-duties failure"
          },
          "409": {
            "description": "UNKNOWN or reconciliation conflict"
          }
        },
        "summary": "Validate and normalize CPF database operation evidence"
      }
    },
    "/cpf/db/operations/{operationId}": {
      "get": {
        "operationId": "getCpfDbOperationEvidence",
        "parameters": [
          {
            "in": "path",
            "name": "operationId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation evidence"
          },
          "404": {
            "description": "Operation not found"
          }
        },
        "summary": "Read normalized DB operation evidence"
      }
    }
  },
  "x-cpf-owner": "cpf-tools DB",
  "x-cpf-provider-status": "DB_PROVIDER_CONTRACT_IMPLEMENTED",
  "x-cpf-route-consumer-status": "CROSS_SESSION_REQUIRED"
}
