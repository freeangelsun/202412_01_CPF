UPDATE BAT_REMOTE_MESSAGE_LEDGER
   SET status_cd = 'FAILED',
       owner_id = 'RECONCILED',
       lease_until = @NOW6@,
       last_error_cd = ?,
       updated_at = @NOW6@,
       version_no = version_no + 1
 WHERE direction_cd = ?
   AND message_id = ?
   AND status_cd = 'UNKNOWN'
   AND payload_sha256 = ?
   AND attempt_no = ?
   AND version_no = ?
