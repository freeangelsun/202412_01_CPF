UPDATE BAT_SCHEDULE
   SET last_fire_at = ?,
       next_fire_at = ?,
       updated_at = @NOW@
 WHERE schedule_id = ?
   AND ((next_fire_at IS NULL AND ? IS NULL) OR next_fire_at = ?)
   AND EXISTS (
       SELECT 1
         FROM BAT_SCHEDULER_LEASE l
        WHERE l.scheduler_key = ?
          AND l.owner_instance_id = ?
          AND l.fencing_token = ?
          AND l.lease_until >= @NOW6@
   )
