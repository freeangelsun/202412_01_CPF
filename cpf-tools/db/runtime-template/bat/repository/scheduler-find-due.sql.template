SELECT s.schedule_id,
       s.job_id,
       s.cron_expression,
       s.calendar_id,
       s.business_day_only_yn,
       s.holiday_policy,
       s.available_start_time,
       s.available_end_time,
       s.timezone,
       s.next_fire_at
  FROM bat_schedule s
  JOIN bat_job j
    ON j.job_id = s.job_id
 WHERE s.enabled_yn = 'Y'
   AND j.use_yn = 'Y'
   AND (s.next_fire_at IS NULL OR s.next_fire_at <= @NOW@)
 ORDER BY COALESCE(s.next_fire_at, @NOW@), s.schedule_id
 @LIMIT_100@
