UPDATE BAT_SCHEDULER_LEASE
   SET owner_instance_id = ?,
       fencing_token = fencing_token + 1,
       lease_until = @UTC_NOW6_PLUS_MICROS_PARAM@,
       last_heartbeat_at = @UTC_NOW6@,
       updated_at = @UTC_NOW6@
 WHERE scheduler_key = ?
   AND (owner_instance_id = ? OR lease_until < @UTC_NOW6@)
