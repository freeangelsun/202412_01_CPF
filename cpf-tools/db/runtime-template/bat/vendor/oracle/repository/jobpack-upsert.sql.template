MERGE INTO bat_job_pack target
USING (
    SELECT ? job_pack_id, ? owner_domain, ? artifact_coordinate, ? artifact_version,
           ? artifact_checksum, ? signature_present_yn, ? platform_range, ? manifest_json
    FROM dual
) source
ON (target.job_pack_id = source.job_pack_id)
WHEN MATCHED THEN UPDATE SET
    target.owner_domain = source.owner_domain,
    target.artifact_coordinate = source.artifact_coordinate,
    target.artifact_version = source.artifact_version,
    target.artifact_checksum = source.artifact_checksum,
    target.signature_present_yn = source.signature_present_yn,
    target.platform_range = source.platform_range,
    target.manifest_json = source.manifest_json,
    target.last_registered_at = @NOW6@
WHEN NOT MATCHED THEN INSERT (
    job_pack_id, owner_domain, artifact_coordinate, artifact_version, artifact_checksum,
    signature_present_yn, platform_range, manifest_json, last_registered_at
) VALUES (
    source.job_pack_id, source.owner_domain, source.artifact_coordinate, source.artifact_version,
    source.artifact_checksum, source.signature_present_yn, source.platform_range, source.manifest_json, @NOW6@
)
