CREATE TABLE @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item (
    sample_item_id NUMBER(19) GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    sample_key VARCHAR2(100 CHAR) NOT NULL UNIQUE,
    item_name VARCHAR2(200 CHAR) NOT NULL,
    status_code VARCHAR2(30 CHAR) DEFAULT 'ACTIVE' NOT NULL,
    version_no NUMBER(19) DEFAULT 0 NOT NULL,
    idempotency_key VARCHAR2(100 CHAR) NOT NULL UNIQUE,
    transaction_id CHAR(34 CHAR) NOT NULL,
    transaction_sequence NUMBER(19) DEFAULT 1 NOT NULL,
    transaction_at TIMESTAMP(3) DEFAULT CURRENT_TIMESTAMP NOT NULL,
    deleted_yn CHAR(1 CHAR) DEFAULT 'N' NOT NULL,
    created_by VARCHAR2(100 CHAR) DEFAULT '@CPF_SYSTEM_CODE@' NOT NULL,
    created_at TIMESTAMP(3) DEFAULT CURRENT_TIMESTAMP NOT NULL,
    updated_by VARCHAR2(100 CHAR) DEFAULT '@CPF_SYSTEM_CODE@' NOT NULL,
    updated_at TIMESTAMP(3) DEFAULT CURRENT_TIMESTAMP NOT NULL,
    CONSTRAINT ck_@CPF_TABLE_PREFIX@_sample_status CHECK (status_code IN ('ACTIVE','INACTIVE')),
    CONSTRAINT ck_@CPF_TABLE_PREFIX@_sample_deleted CHECK (deleted_yn IN ('Y','N'))
);
CREATE INDEX @CPF_SCHEMA_NAME@.ix_@CPF_TABLE_PREFIX@_sample_status
    ON @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item(status_code, deleted_yn, sample_item_id);
CREATE INDEX @CPF_SCHEMA_NAME@.ix_@CPF_TABLE_PREFIX@_sample_tx
    ON @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item(transaction_id, transaction_sequence);

GRANT SELECT, INSERT, UPDATE, DELETE
    ON @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item
    TO @CPF_RUNTIME_USERNAME@;
