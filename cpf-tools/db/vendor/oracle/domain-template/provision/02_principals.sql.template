-- Secret tokens in this template are rendered only into an ephemeral file by
-- initialize-domain-database.ps1. Rendered passwords must never be persisted.
DECLARE
    cpf_principal_count NUMBER;
BEGIN
    SELECT COUNT(*) INTO cpf_principal_count
      FROM all_users
     WHERE username = UPPER('@CPF_MIGRATION_USERNAME@');
    IF cpf_principal_count = 0 THEN
        EXECUTE IMMEDIATE
            'CREATE USER @CPF_MIGRATION_USERNAME@ IDENTIFIED BY "@CPF_MIGRATION_PASSWORD_SQL_LITERAL@" ACCOUNT UNLOCK';
    ELSE
        EXECUTE IMMEDIATE
            'ALTER USER @CPF_MIGRATION_USERNAME@ IDENTIFIED BY "@CPF_MIGRATION_PASSWORD_SQL_LITERAL@" ACCOUNT UNLOCK';
    END IF;

    SELECT COUNT(*) INTO cpf_principal_count
      FROM all_users
     WHERE username = UPPER('@CPF_RUNTIME_USERNAME@');
    IF cpf_principal_count = 0 THEN
        EXECUTE IMMEDIATE
            'CREATE USER @CPF_RUNTIME_USERNAME@ IDENTIFIED BY "@CPF_RUNTIME_PASSWORD_SQL_LITERAL@" ACCOUNT UNLOCK';
    ELSE
        EXECUTE IMMEDIATE
            'ALTER USER @CPF_RUNTIME_USERNAME@ IDENTIFIED BY "@CPF_RUNTIME_PASSWORD_SQL_LITERAL@" ACCOUNT UNLOCK';
    END IF;
END;
/

GRANT CREATE SESSION, CREATE TABLE, CREATE SEQUENCE, CREATE PROCEDURE, CREATE TRIGGER
    TO @CPF_MIGRATION_USERNAME@;
GRANT UNLIMITED TABLESPACE TO @CPF_MIGRATION_USERNAME@;
GRANT CREATE SESSION TO @CPF_RUNTIME_USERNAME@;
