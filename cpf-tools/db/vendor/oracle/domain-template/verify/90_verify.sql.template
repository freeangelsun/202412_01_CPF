SELECT CASE
    WHEN (SELECT COUNT(*) FROM all_tables WHERE owner=UPPER('@CPF_SCHEMA_NAME@') AND table_name IN (UPPER('@CPF_TABLE_PREFIX@_sample_item'),UPPER('@CPF_TABLE_PREFIX@_sample_item_idem'))) = 2
     AND (SELECT COUNT(DISTINCT column_name) FROM all_tab_columns WHERE owner=UPPER('@CPF_SCHEMA_NAME@') AND table_name=UPPER('@CPF_TABLE_PREFIX@_sample_item_idem') AND column_name IN (UPPER('idempotency_key'),UPPER('operation_code'),UPPER('request_hash'),UPPER('sample_item_id'),UPPER('result_version'),UPPER('deleted_yn'),UPPER('transaction_id'),UPPER('created_at'))) = 8
     AND (SELECT COUNT(*) FROM all_constraints WHERE owner=UPPER('@CPF_SCHEMA_NAME@') AND table_name=UPPER('@CPF_TABLE_PREFIX@_sample_item_idem') AND constraint_type='P') = 1
     AND (SELECT COUNT(*) FROM all_constraints WHERE owner=UPPER('@CPF_SCHEMA_NAME@') AND table_name=UPPER('@CPF_TABLE_PREFIX@_sample_item_idem') AND constraint_type='R') = 1
     AND (SELECT COUNT(*) FROM all_indexes WHERE owner=UPPER('@CPF_SCHEMA_NAME@') AND table_name=UPPER('@CPF_TABLE_PREFIX@_sample_item_idem') AND index_name IN (UPPER('ix_@CPF_TABLE_PREFIX@_sample_idem_item'),UPPER('ix_@CPF_TABLE_PREFIX@_sample_idem_tx'))) = 2
    THEN 'PASS' ELSE 'FAILED' END AS generated_domain_idempotency_verify FROM dual;
