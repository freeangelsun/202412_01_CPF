-- Secret tokens in this template are rendered only into an ephemeral file by
-- initialize-domain-database.ps1. Rendered passwords must never be persisted.
DO $cpf$
BEGIN
    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '@CPF_MIGRATION_USERNAME@') THEN
        EXECUTE format(
            'ALTER ROLE %I WITH LOGIN PASSWORD %L',
            '@CPF_MIGRATION_USERNAME@',
            '@CPF_MIGRATION_PASSWORD_SQL_LITERAL@');
    ELSE
        EXECUTE format(
            'CREATE ROLE %I LOGIN PASSWORD %L',
            '@CPF_MIGRATION_USERNAME@',
            '@CPF_MIGRATION_PASSWORD_SQL_LITERAL@');
    END IF;

    IF EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '@CPF_RUNTIME_USERNAME@') THEN
        EXECUTE format(
            'ALTER ROLE %I WITH LOGIN PASSWORD %L',
            '@CPF_RUNTIME_USERNAME@',
            '@CPF_RUNTIME_PASSWORD_SQL_LITERAL@');
    ELSE
        EXECUTE format(
            'CREATE ROLE %I LOGIN PASSWORD %L',
            '@CPF_RUNTIME_USERNAME@',
            '@CPF_RUNTIME_PASSWORD_SQL_LITERAL@');
    END IF;
END
$cpf$;

GRANT CONNECT, CREATE ON DATABASE "@CPF_DATABASE_NAME@" TO "@CPF_MIGRATION_USERNAME@";
GRANT CONNECT ON DATABASE "@CPF_DATABASE_NAME@" TO "@CPF_RUNTIME_USERNAME@";

CREATE SCHEMA IF NOT EXISTS "@CPF_SCHEMA_NAME@" AUTHORIZATION "@CPF_MIGRATION_USERNAME@";
ALTER SCHEMA "@CPF_SCHEMA_NAME@" OWNER TO "@CPF_MIGRATION_USERNAME@";
GRANT USAGE, CREATE ON SCHEMA "@CPF_SCHEMA_NAME@" TO "@CPF_MIGRATION_USERNAME@";
GRANT USAGE ON SCHEMA "@CPF_SCHEMA_NAME@" TO "@CPF_RUNTIME_USERNAME@";

ALTER DEFAULT PRIVILEGES FOR ROLE "@CPF_MIGRATION_USERNAME@" IN SCHEMA "@CPF_SCHEMA_NAME@"
    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO "@CPF_RUNTIME_USERNAME@";
ALTER DEFAULT PRIVILEGES FOR ROLE "@CPF_MIGRATION_USERNAME@" IN SCHEMA "@CPF_SCHEMA_NAME@"
    GRANT USAGE, SELECT ON SEQUENCES TO "@CPF_RUNTIME_USERNAME@";
