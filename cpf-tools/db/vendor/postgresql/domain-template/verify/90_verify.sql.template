SELECT CASE
    WHEN (SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='@CPF_SCHEMA_NAME@' AND table_name IN ('@CPF_TABLE_PREFIX@_sample_item','@CPF_TABLE_PREFIX@_sample_item_idem')) = 2
     AND (SELECT COUNT(DISTINCT column_name) FROM information_schema.columns WHERE table_schema='@CPF_SCHEMA_NAME@' AND table_name='@CPF_TABLE_PREFIX@_sample_item_idem' AND column_name IN ('idempotency_key','operation_code','request_hash','sample_item_id','result_version','deleted_yn','transaction_id','created_at')) = 8
     AND (SELECT COUNT(*) FROM pg_constraint WHERE conrelid=to_regclass(format('%I.%I','@CPF_SCHEMA_NAME@','@CPF_TABLE_PREFIX@_sample_item_idem')) AND contype='p') = 1
     AND (SELECT COUNT(*) FROM pg_constraint WHERE conrelid=to_regclass(format('%I.%I','@CPF_SCHEMA_NAME@','@CPF_TABLE_PREFIX@_sample_item_idem')) AND contype='f') = 1
     AND (SELECT COUNT(*) FROM pg_indexes WHERE schemaname='@CPF_SCHEMA_NAME@' AND tablename='@CPF_TABLE_PREFIX@_sample_item_idem' AND indexname IN ('ix_@CPF_TABLE_PREFIX@_sample_idem_item','ix_@CPF_TABLE_PREFIX@_sample_idem_tx')) = 2
    THEN 'PASS' ELSE 'FAILED' END AS generated_domain_idempotency_verify;
