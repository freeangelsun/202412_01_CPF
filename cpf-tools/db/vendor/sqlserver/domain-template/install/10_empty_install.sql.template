IF OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item', N'U') IS NULL
BEGIN
    CREATE TABLE @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item (
        sample_item_id BIGINT IDENTITY(1,1) NOT NULL PRIMARY KEY,
        sample_key NVARCHAR(100) NOT NULL UNIQUE,
        item_name NVARCHAR(200) NOT NULL,
        status_code NVARCHAR(30) NOT NULL DEFAULT 'ACTIVE',
        version_no BIGINT NOT NULL DEFAULT 0,
        idempotency_key NVARCHAR(100) NOT NULL UNIQUE,
        transaction_id CHAR(34) NOT NULL,
        transaction_sequence BIGINT NOT NULL DEFAULT 1,
        transaction_at DATETIME2(3) NOT NULL DEFAULT SYSUTCDATETIME(),
        deleted_yn CHAR(1) NOT NULL DEFAULT 'N',
        created_by NVARCHAR(100) NOT NULL DEFAULT '@CPF_SYSTEM_CODE@',
        created_at DATETIME2(3) NOT NULL DEFAULT SYSUTCDATETIME(),
        updated_by NVARCHAR(100) NOT NULL DEFAULT '@CPF_SYSTEM_CODE@',
        updated_at DATETIME2(3) NOT NULL DEFAULT SYSUTCDATETIME(),
        CONSTRAINT ck_@CPF_TABLE_PREFIX@_sample_status CHECK (status_code IN ('ACTIVE','INACTIVE')),
        CONSTRAINT ck_@CPF_TABLE_PREFIX@_sample_deleted CHECK (deleted_yn IN ('Y','N'))
    );
    CREATE INDEX ix_@CPF_TABLE_PREFIX@_sample_status ON @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item(status_code, deleted_yn, sample_item_id);
    CREATE INDEX ix_@CPF_TABLE_PREFIX@_sample_tx ON @CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item(transaction_id, transaction_sequence);
END;
