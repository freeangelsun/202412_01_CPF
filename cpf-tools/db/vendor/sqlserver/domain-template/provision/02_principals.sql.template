-- Secret tokens in this template are rendered only into an ephemeral file by
-- initialize-domain-database.ps1. Rendered passwords must never be persisted.
IF SUSER_ID(N'@CPF_MIGRATION_USERNAME@') IS NULL
    EXEC(N'CREATE LOGIN [@CPF_MIGRATION_USERNAME@] WITH PASSWORD = N''@CPF_MIGRATION_PASSWORD_SQL_LITERAL@'', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF');
ELSE
    EXEC(N'ALTER LOGIN [@CPF_MIGRATION_USERNAME@] WITH PASSWORD = N''@CPF_MIGRATION_PASSWORD_SQL_LITERAL@''');

IF SUSER_ID(N'@CPF_RUNTIME_USERNAME@') IS NULL
    EXEC(N'CREATE LOGIN [@CPF_RUNTIME_USERNAME@] WITH PASSWORD = N''@CPF_RUNTIME_PASSWORD_SQL_LITERAL@'', CHECK_POLICY = ON, CHECK_EXPIRATION = OFF');
ELSE
    EXEC(N'ALTER LOGIN [@CPF_RUNTIME_USERNAME@] WITH PASSWORD = N''@CPF_RUNTIME_PASSWORD_SQL_LITERAL@''');

IF DATABASE_PRINCIPAL_ID(N'@CPF_MIGRATION_USERNAME@') IS NULL
    CREATE USER [@CPF_MIGRATION_USERNAME@] FOR LOGIN [@CPF_MIGRATION_USERNAME@];
IF DATABASE_PRINCIPAL_ID(N'@CPF_RUNTIME_USERNAME@') IS NULL
    CREATE USER [@CPF_RUNTIME_USERNAME@] FOR LOGIN [@CPF_RUNTIME_USERNAME@];

IF SCHEMA_ID(N'@CPF_SCHEMA_NAME@') IS NULL
    EXEC(N'CREATE SCHEMA [@CPF_SCHEMA_NAME@] AUTHORIZATION [@CPF_MIGRATION_USERNAME@]');
ELSE
    ALTER AUTHORIZATION ON SCHEMA::[@CPF_SCHEMA_NAME@] TO [@CPF_MIGRATION_USERNAME@];

IF IS_ROLEMEMBER(N'db_ddladmin', N'@CPF_MIGRATION_USERNAME@') <> 1
    ALTER ROLE [db_ddladmin] ADD MEMBER [@CPF_MIGRATION_USERNAME@];
IF IS_ROLEMEMBER(N'db_datareader', N'@CPF_RUNTIME_USERNAME@') <> 1
    ALTER ROLE [db_datareader] ADD MEMBER [@CPF_RUNTIME_USERNAME@];
IF IS_ROLEMEMBER(N'db_datawriter', N'@CPF_RUNTIME_USERNAME@') <> 1
    ALTER ROLE [db_datawriter] ADD MEMBER [@CPF_RUNTIME_USERNAME@];

GRANT CONTROL ON SCHEMA::[@CPF_SCHEMA_NAME@] TO [@CPF_MIGRATION_USERNAME@];
GRANT SELECT, INSERT, UPDATE, DELETE ON SCHEMA::[@CPF_SCHEMA_NAME@] TO [@CPF_RUNTIME_USERNAME@];
GRANT EXECUTE ON SCHEMA::[@CPF_SCHEMA_NAME@] TO [@CPF_RUNTIME_USERNAME@];

