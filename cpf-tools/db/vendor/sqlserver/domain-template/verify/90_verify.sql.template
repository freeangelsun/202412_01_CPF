SELECT CASE
    WHEN OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item', N'U') IS NOT NULL
     AND (SELECT COUNT(DISTINCT c.name)
          FROM sys.columns c
          WHERE c.object_id = OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item')
            AND c.name IN (
                'sample_item_id', 'sample_key', 'item_name', 'status_code', 'version_no',
                'idempotency_key', 'transaction_id', 'transaction_sequence', 'transaction_at',
                'deleted_yn', 'created_by', 'created_at', 'updated_by', 'updated_at'
            )) = 14
     AND (SELECT COUNT(*)
          FROM sys.columns c
          JOIN sys.types t ON t.user_type_id = c.user_type_id
          WHERE c.object_id = OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item')
            AND c.name = 'transaction_id'
            AND t.name = 'char'
            AND c.max_length = 34) = 1
     AND (SELECT COUNT(*)
          FROM sys.key_constraints kc
          WHERE kc.parent_object_id = OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item')
            AND kc.type IN ('PK', 'UQ')) >= 3
     AND (SELECT COUNT(*)
          FROM sys.check_constraints cc
          WHERE cc.parent_object_id = OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item')
            AND cc.name IN (
                'ck_@CPF_TABLE_PREFIX@_sample_status',
                'ck_@CPF_TABLE_PREFIX@_sample_deleted'
            )) = 2
     AND (SELECT COUNT(*)
          FROM sys.indexes i
          WHERE i.object_id = OBJECT_ID(N'@CPF_SCHEMA_NAME@.@CPF_TABLE_PREFIX@_sample_item')
            AND i.name IN (
                'ix_@CPF_TABLE_PREFIX@_sample_status',
                'ix_@CPF_TABLE_PREFIX@_sample_tx'
            )) = 2
    THEN 'PASS'
    ELSE 'FAILED'
END AS minimal_transaction_domain_verify;
