      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:*/*",
        "http://localhost:*/*"
      ],
      "webOrigins": ["+"]
    }
  ]
}
