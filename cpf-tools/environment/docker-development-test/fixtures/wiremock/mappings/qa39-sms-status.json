{
  "request": {
    "method": "GET",
    "urlPathPattern": "/qa39/sms/messages/[0-9a-fA-F-]+"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "providerMessageId": "{{request.pathSegments.[3]}}",
      "status": "DELIVERED",
      "receiptAt": "{{now format='yyyy-MM-dd''T''HH:mm:ssXXX'}}"
    },
    "transformers": [
      "response-template"
    ]
  }
}
