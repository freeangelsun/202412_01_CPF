  "standardInheritancePolicy": {
    "policyVersion": "1.0",
    "mandatoryStandards": [
      "standard-error",
      "header-context",
      "transaction-id",
      "security-boundary",
      "audit",
      "masking",
      "observability",
      "config",
      "dependency-version",
      "architecture-gate"
    ],
    "defaultProfile": "base",
    "optionalCapabilities": [
      "data",
      "messaging",
      "integration",
      "file",
      "notification",
      "security",
      "platform-operations"
    ],
    "unselectedCapabilityPolicy": "NO_DEPENDENCY_NO_BEAN_NO_CONFIG_NO_SQL",
    "enforcement": [
      "generator",
      "convention-plugin",
      "runtime-auto-configuration",
      "architecture-test",
      "resolved-lock"
    ],
    "failClosed": true,
    "defaultStarter": "cpf-starter"
  },
  "approvedExternalExceptionPolicy": {
    "schemaVersion": "2.0",
    "registryPath": "config/cpf-approved-exceptions.csv",
    "runtimeResource": "META-INF/cpf/cpf-approved-exceptions.csv",
    "requiredFields": [
      "exception_id",
      "module",
      "capability",
      "artifact",
      "version",
      "owner",
      "reason",
      "standard_path_gap",
      "environments",
      "security_impact",
      "license_review",
      "supply_chain_review",
      "operations_responsibility",
      "approved_by",
      "approved_at",
      "expires_at",
      "rollback",
      "return_plan",
      "rule_ids",
      "config_files",
      "evidence_path",
      "status",
      "config_hash"
    ],
    "approvedStatus": "APPROVED",
    "hashAlgorithm": "SHA-256-METADATA-AND-CONFIG-CONTENT",
    "versionDriftPolicy": "FAIL_CLOSED",
    "expiredPolicy": "FAIL_CLOSED",
    "unregisteredPolicy": "FAIL_CLOSED",
    "returnToStandardPathRequired": true,
    "registryFormat": "CSV",
    "configFilePolicy": "GENERATED_DOMAIN_SRC_MAIN_RESOURCES_ONLY",
    "buildValidation": "METADATA_AND_CONFIG_BYTES_SHA256",
    "runtimeValidation": "PACKAGED_REGISTRY_AND_CONFIG_BYTES_SHA256"
  },
