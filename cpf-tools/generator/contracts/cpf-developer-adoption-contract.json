    },
    {
      "name": "CpfMessageSource.resolve",
      "source": "cpf-common/src/main/java/com/cpf/common/message/api/CpfMessageSource.java",
      "when": "표준 메시지 조회"
    },
    {
      "name": "CpfParameterService.requiredValue",
      "source": "cpf-common/src/main/java/com/cpf/common/parameter/api/CpfParameterService.java",
      "when": "운영 파라미터 조회"
    },
    {
      "name": "CpfCalendarService.nextBusinessDay",
      "source": "cpf-common/src/main/java/com/cpf/common/calendar/api/CpfCalendarService.java",
      "when": "영업일 계산"
    },
    {
      "name": "@CpfIdempotent",
      "source": "cpf-starters/base/runtime/src/main/java/com/cpf/reliability/api/CpfIdempotent.java",
      "when": "중복 side effect 방지"
    },
    {
      "name": "@CpfLogging",
      "source": "cpf-starters/base/runtime/src/main/java/com/cpf/foundation/annotation/CpfLogging.java",
      "when": "업무/운영 로그 표준화"
    },
    {
      "name": "@CpfPermission",
      "source": "cpf-starters/security/src/main/java/com/cpf/security/api/annotation/CpfPermission.java",
      "when": "권한 검증"
    },
    {
      "name": "@CpfApprovalRequired",
      "source": "cpf-starters/security/src/main/java/com/cpf/security/api/annotation/CpfApprovalRequired.java",
      "when": "위험 조치 승인"
    },
    {
      "name": "@CpfAudit",
      "source": "cpf-starters/platform-operations/src/main/java/com/cpf/platform/operations/api/annotation/CpfAudit.java",
      "when": "감사 이벤트"
    },
    {
      "name": "@CpfMessageListener",
      "source": "cpf-starters/messaging/src/main/java/com/cpf/messaging/api/CpfMessageListener.java",
      "when": "표준 메시지 Consumer"
    },
    {
      "name": "@CpfBatchJob / @CpfBatchStep",
      "source": "cpf-batch/api/src/main/java/com/cpf/batch/api/annotation/CpfBatchJob.java",
      "secondarySource": "cpf-batch/api/src/main/java/com/cpf/batch/api/annotation/CpfBatchStep.java",
      "when": "Batch Job/Step 개발"
    }
  ],
  "compatibility": {
    "semver": {
      "major": "breaking",
      "minor": "backward-compatible-capability",
      "patch": "compatible-fix"
    },
    "deprecation": "deprecated-before-removal",
    "inspectionTool": "cpf-tools/verification/tools/report-cpf-upgrade-impact.py"
  }
}
