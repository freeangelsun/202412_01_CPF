{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpf-domain.schema.json",
  "title": "CPF Generated Customer Domain Definition",
  "description": "Generated Customer Domain의 OS-neutral 선언형 정본. Domain Generator는 Online 업무 Source만 생성하며 Batch는 프로젝트 초기 구성에서 cpf-starter-batch Capability로 별도 선택한다. DB Vendor는 중앙 DB Lifecycle/환경에서 선택한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "database",
    "preset",
    "modules",
    "generation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "properties": {
              "sampleTransaction": {
                "const": true
              }
            },
            "required": [
              "sampleTransaction"
            ]
          }
        }
      },
      "then": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "required": [
              "persistence"
            ],
            "properties": {
              "persistence": {
                "const": "mybatis"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preset": {
            "const": "minimal"
          }
        },
        "required": [
          "preset"
        ]
      },
      "then": {
        "properties": {
          "features": {
            "properties": {
              "persistence": {
                "const": "none"
              },
              "httpClient": {
                "const": false
              },
              "resilience": {
                "const": false
              },
              "cache": {
                "const": "none"
              },
              "messaging": {
                "const": "none"
              },
              "objectStorage": {
                "const": "none"
              },
              "securityProfile": {
                "const": "resource-server"
              }
            }
          },
          "generation": {
            "properties": {
              "sampleTransaction": {
                "const": false
              }
            },
            "required": [
              "sampleTransaction"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "systemCode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,49}$"
        },
        "systemCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{2}$"
        },
        "packageName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "not": {
            "pattern": "^com\\.cpf(?:\\.|$)"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "tablePrefix"
      ],
      "properties": {
        "role": {
          "const": "CUSTOMER_BUSINESS_DB"
        },
        "tablePrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,19}$"
        }
      }
    },
    "preset": {
      "enum": [
        "minimal",
        "standard-enterprise",
        "full-enterprise",
        "custom"
      ]
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "online"
      ],
      "properties": {
        "online": {
          "type": "boolean",
          "const": true,
          "description": "Generated Domain은 Online 업무 Runtime만 생성한다. Batch는 이 입력의 대상이 아니다."
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "enum": [
            "none",
            "jdbc",
            "mybatis",
            "jpa"
          ]
        },
        "httpClient": {
          "type": "boolean"
        },
        "resilience": {
          "type": "boolean"
        },
        "cache": {
          "enum": [
            "none",
            "caffeine",
            "redis",
            "valkey"
          ]
        },
        "messaging": {
          "enum": [
            "none",
            "kafka",
            "rabbitmq",
            "jms",
            "ibm-mq"
          ]
        },
        "objectStorage": {
          "enum": [
            "none",
            "s3"
          ]
        },
        "securityProfile": {
          "enum": [
            "resource-server",
            "browser-session-valkey",
            "service-identity",
            "oidc"
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleTransaction"
      ],
      "properties": {
        "sampleTransaction": {
          "type": "boolean"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localOnlinePort": {
          "type": "integer",
          "minimum": 18080,
          "maximum": 18999
        }
      }
    },
    "domainDependencies": {
      "type": "object",
      "description": "논리 CPF Domain dependency. 실제 endpoint/credential은 Runtime Binding이 소유한다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "systemCode"
        ],
        "properties": {
          "systemCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{2}$"
          }
        }
      }
    },
    "externalClients": {
      "type": "object",
      "description": "외부기관/채널의 논리 client 선언. 실제 endpoint/Secret은 포함하지 않는다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "capability": {
            "enum": [
              "http",
              "tcp",
              "soap",
              "fixed-length",
              "iso8583",
              "sftp",
              "messaging",
              "object-storage"
            ]
          }
        }
      }
    }
  }
}
