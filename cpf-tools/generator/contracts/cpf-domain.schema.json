{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cpf-domain.schema.json",
  "title": "CPF Generated Customer Domain Definition",
  "description": "Generated Business Domain의 OS-neutral 논리 정본. Source Tree는 online/선택 batch/필요 시 domain만 사용하며 DB Vendor/Host/Schema/Secret은 local/environment binding profile이 소유한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain",
    "database",
    "preset",
    "modules",
    "generation"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "properties": {
              "sampleTransaction": {
                "const": true
              }
            },
            "required": [
              "sampleTransaction"
            ]
          }
        }
      },
      "then": {
        "required": [
          "features"
        ],
        "properties": {
          "features": {
            "required": [
              "persistence"
            ],
            "properties": {
              "persistence": {
                "const": "mybatis"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "preset": {
            "const": "minimal"
          }
        },
        "required": [
          "preset"
        ]
      },
      "then": {
        "properties": {
          "features": {
            "properties": {
              "persistence": {
                "const": "none"
              },
              "httpClient": {
                "const": false
              },
              "resilience": {
                "const": false
              },
              "cache": {
                "const": "none"
              },
              "messaging": {
                "const": "none"
              },
              "objectStorage": {
                "const": "none"
              },
              "securityProfile": {
                "const": "resource-server"
              }
            }
          },
          "generation": {
            "properties": {
              "sampleTransaction": {
                "const": false
              }
            },
            "required": [
              "sampleTransaction"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "systemCode"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,49}$"
        },
        "systemCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{2}$"
        },
        "packageName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$",
          "not": {
            "pattern": "^com\\.cpf(?:\\.|$)"
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "tablePrefix"
      ],
      "properties": {
        "role": {
          "const": "CUSTOMER_BUSINESS_DB"
        },
        "tablePrefix": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,19}$"
        }
      }
    },
    "preset": {
      "enum": [
        "minimal",
        "standard-enterprise",
        "full-enterprise",
        "custom"
      ]
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "online"
      ],
      "properties": {
        "online": {
          "type": "boolean",
          "description": "Generated Domain의 선택형 Online 업무 Runtime. online/batch 중 최소 하나는 true여야 한다."
        },
        "batch": {
          "type": "boolean",
          "default": false,
          "description": "선택형 업무 Batch Runtime. true일 때 cpf-<domain>/batch를 생성합니다."
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "enum": [
            "none",
            "jdbc",
            "mybatis",
            "jpa"
          ]
        },
        "httpClient": {
          "type": "boolean"
        },
        "resilience": {
          "type": "boolean"
        },
        "cache": {
          "enum": [
            "none",
            "caffeine",
            "redis",
            "valkey"
          ]
        },
        "messaging": {
          "enum": [
            "none",
            "kafka",
            "rabbitmq",
            "jms",
            "ibm-mq"
          ]
        },
        "objectStorage": {
          "enum": [
            "none",
            "s3"
          ]
        },
        "securityProfile": {
          "enum": [
            "resource-server",
            "browser-session-valkey",
            "service-identity",
            "oidc"
          ]
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampleTransaction"
      ],
      "properties": {
        "sampleTransaction": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "generated",
            "prebuilt"
          ],
          "default": "generated",
          "description": "Generated Domain lifecycle owner. prebuilt는 Source를 재생성하지 않고 canonical identity/physical contract만 검증합니다."
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "localOnlinePort": {
          "type": "integer",
          "minimum": 18080,
          "maximum": 18999
        }
      }
    },
    "domainDependencies": {
      "type": "object",
      "description": "논리 CPF Domain dependency. 실제 endpoint/credential은 Runtime Binding이 소유한다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "systemCode",
          "operations"
        ],
        "properties": {
          "systemCode": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9]{2}$"
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,119}$"
            },
            "description": "Target Public Operation ID 목록"
          }
        }
      }
    },
    "externalClients": {
      "type": "object",
      "description": "외부기관/채널의 논리 client 선언. 실제 endpoint/Secret은 포함하지 않는다.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "capability": {
            "enum": [
              "http",
              "fixed-length",
              "messaging",
              "object-storage"
            ]
          }
        }
      }
    }
  }
}
