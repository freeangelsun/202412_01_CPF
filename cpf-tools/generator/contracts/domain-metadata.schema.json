{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpf.local/schemas/generator/domain-metadata.schema.json",
  "title": "CPF Generated Domain Metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metadataVersion",
    "domainType",
    "domainName",
    "systemCode",
    "projectName",
    "moduleName",
    "packageName",
    "schemaName",
    "tablePrefix",
    "databaseEnabled",
    "dependencyModel",
    "platformVersion",
    "templateContractVersion",
    "capabilities",
    "minimalTransactionContract"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "databaseEnabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "databaseVendor"
        ]
      }
    }
  ],
  "properties": {
    "metadataVersion": {
      "const": "1.0"
    },
    "domainType": {
      "const": "GENERATED_DOMAIN"
    },
    "domainName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,29}$"
    },
    "systemCode": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]{2}$"
    },
    "projectName": {
      "type": "string",
      "pattern": "^cpf-[a-z][a-z0-9]{1,29}$"
    },
    "moduleName": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]{1,49}$"
    },
    "packageName": {
      "type": "string",
      "pattern": "^com\\.cpf\\.[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)*$"
    },
    "schemaName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{1,29}$"
    },
    "tablePrefix": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,19}$"
    },
    "databaseEnabled": {
      "type": "boolean"
    },
    "dependencyModel": {
      "enum": [
        "root-project",
        "published-artifact"
      ]
    },
    "platformVersion": {
      "type": "string",
      "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$"
    },
    "templateContractVersion": {
      "const": "1.0"
    },
    "databaseVendor": {
      "enum": [
        "mariadb",
        "mysql",
        "postgresql",
        "oracle",
        "sqlserver"
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "online",
        "database",
        "batch",
        "centerCut",
        "external",
        "messaging",
        "file",
        "securityAudit",
        "ui",
        "bzaMenu",
        "productionProfile"
      ],
      "properties": {
        "online": {
          "type": "boolean"
        },
        "database": {
          "type": "boolean"
        },
        "batch": {
          "type": "boolean"
        },
        "centerCut": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "messaging": {
          "type": "boolean"
        },
        "file": {
          "type": "boolean"
        },
        "securityAudit": {
          "type": "boolean"
        },
        "ui": {
          "type": "boolean"
        },
        "bzaMenu": {
          "type": "boolean"
        },
        "productionProfile": {
          "type": "boolean"
        }
      }
    },
    "minimalTransactionContract": {
      "type": "object",
      "required": [
        "model",
        "logicalTable",
        "requiredColumns",
        "requiredKeys",
        "requiredIndexes",
        "requiredChecks",
        "operations"
      ],
      "properties": {
        "model": {
          "const": "sample-item"
        },
        "logicalTable": {
          "type": "string"
        },
        "requiredColumns": {
          "type": "array",
          "minItems": 14,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sample_item_id",
              "sample_key",
              "item_name",
              "status_code",
              "version_no",
              "idempotency_key",
              "transaction_id",
              "transaction_sequence",
              "transaction_at",
              "deleted_yn",
              "created_by",
              "created_at",
              "updated_by",
              "updated_at"
            ]
          }
        },
        "requiredKeys": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "primary-key",
              "sample-key-unique",
              "idempotency-key-unique"
            ]
          }
        },
        "requiredIndexes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "status-deleted-id",
              "transaction-id-sequence"
            ]
          }
        },
        "requiredChecks": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "status-active-inactive",
              "deleted-yn"
            ]
          }
        },
        "operations": {
          "type": "array",
          "minItems": 22,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create",
              "read",
              "update",
              "delete",
              "search",
              "offset-page",
              "slice",
              "cursor",
              "validation",
              "transaction-commit",
              "transaction-rollback",
              "optimistic-lock",
              "duplicate",
              "local-call",
              "remote-call",
              "standard-header",
              "transaction-id",
              "error-mapping",
              "idempotency",
              "audit",
              "masking",
              "framework-edu"
            ]
          }
        }
      }
    }
  }
}
