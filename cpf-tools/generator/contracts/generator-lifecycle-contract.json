{
  "schemaVersion": 5,
  "contractId": "CPF-GENERATOR-LIFECYCLE-5",
  "owner": "cpf-tools/generator",
  "canonicalEngine": "cpf-tools/generator/engine/cpf_domain_generator.py",
  "canonicalCli": "cpf-tools/runtime/cli/cpf.py",
  "transientInputSchema": "cpf-tools/generator/contracts/cpf-domain.schema.json",
  "developerContract": "cpf-<domain>/gradle.properties",
  "supportedVendors": [
    "mariadb",
    "postgresql",
    "oracle"
  ],
  "operations": [
    "preflight",
    "dry-run",
    "generate",
    "diff",
    "regenerate",
    "upgrade",
    "remove",
    "restore",
    "verify"
  ],
  "transientState": {
    "directory": "cpf-docs/work/evidence/generated/domain-generator/verification/cpf-<domain>",
    "stateFile": "generation-state.json",
    "verificationFile": "verify-result.json",
    "db3Directory": "db3/<vendor>",
    "customerProjectMetadata": "NONE"
  },
  "forbiddenPermanentProjectEntries": [
    ".cpf",
    "README.md",
    "verification",
    "canonical",
    "vendors",
    "generator.lock",
    "manifest"
    ,"cpf-domain.yaml"
    ,"cpf-generator.lock.json"
  ],
  "userProtection": {
    "generatedFileDriftBlocksRegenerate": true,
    "generatedFileDriftBlocksUpgrade": true,
    "generatedFileDriftBlocksRemove": true,
    "unmanagedFilesAreNeverRemoved": true,
    "databaseObjectsNeverAutoDropped": true,
    "restoreRequiresMatchingContractAndExpectedSeed": true,
    "frameworkIntegrationPointsRemovedWithDomain": true
  },
  "topology": {
    "generatedRoot": "cpf-<domain>",
    "repositoryRegressionRoots": [
      "cpf-member",
      "cpf-external"
    ],
    "thirdDomainVerificationRoot": "cpf-docs/work/evidence/generated/domain-generator/verification/<scenario>"
  },
  "releaseEvidence": {
    "requiredVendors": [
      "mariadb",
      "postgresql",
      "oracle"
    ],
    "requireExactSha": true,
    "requireSanitized": true,
    "runtimeSuccessNotInferredFromStaticGate": true
  },
  "localRuntimeIntegration": {
    "descriptor": "<runtime>/build/generated/cpf-runtime-descriptor/META-INF/cpf/generated-domain.properties",
    "sourceControlled": false,
    "defaultMode": "local-integrated",
    "defaultPortPolicy": "single-http-port",
    "gatewayRequired": false,
    "distributedPortsUsedOnlyWhenTopologySplits": true
  },
  "removeImpact": [
    "generated source/resources/tests",
    "generated runtime descriptor",
    "generated build outputs",
    "local integrated classpath discovery",
    "distributed port/registry derived from Developer contract",
    "distribution manifest derived from Developer contract",
    "settings/includeBuild derived from physical root",
    "Developer contract with the Generated project"
  ],
  "generatedDatabaseAssets": {
    "owner": "CPF_DB_RENDERER",
    "root": "cpf-docs/work/evidence/generated/domain-generator/verification/cpf-<domain>/db3/<vendor>",
    "vendors": [
      "mariadb",
      "postgresql",
      "oracle"
    ],
    "lifecycle": [
      "install",
      "migration",
      "seed",
      "verify",
      "rollback"
    ],
    "sourceControlled": false,
    "generatedDomainRoot": false,
    "purpose": "Developer gradle.properties 계약 + environment binding에서 transient/release DB3 pack을 render하며 Generated Domain source root에는 vendor/db directory를 두지 않는다."
  },
  "workspaceOwnershipLock": {
    "sourceControlled": false,
    "status": "FORBIDDEN",
    "freshCloneRecovery": "DETERMINISTIC_CONTRACT_PARITY_TO_TRANSIENT_STATE",
    "generatedProjectMetadata": false
  }
}
