{
  "schemaVersion": 1,
  "officialDatabaseVendors": [
    "oracle",
    "postgresql",
    "mariadb"
  ],
  "unsupportedDatabaseTokens": [
    "mysql",
    "mssql",
    "sqlserver",
    "h2"
  ],
  "moduleOwners": [
    {
      "prefix": "cpf-tools/runtime/cpf-local-runtime/",
      "owner": "cpf-tools",
      "responsibility": "same-JVM local runtime topology that assembles multiple runtimes; not a system",
      "architectureRole": "TOPOLOGY",
      "publicDistributionSurface": "PUBLIC_BINARY_RUNTIME"
    },
    {
      "prefix": "cpf-batch/control-plane/",
      "owner": "cpf-batch",
      "responsibility": "batch operations control plane API",
      "architectureRole": "BATCH_CONTROL_PLANE",
      "publicDistributionSurface": "PUBLIC_BINARY_RUNTIME"
    },
    {
      "prefix": "cpf-starters/common/",
      "owner": "cpf-starters",
      "responsibility": "cpf-common runtime auto-configuration, durable cache refresh wiring and provider composition",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "cpf-backoffice-web/",
      "owner": "cpf-backoffice-web",
      "responsibility": "DB-less external channel/BFF reference for Backoffice business transactions",
      "architectureRole": "CHANNEL_FRONT",
      "publicDistributionSurface": "PUBLIC_SOURCE_DEVELOPMENT"
    },
    {
      "prefix": "cpf-backoffice/",
      "owner": "cpf-backoffice",
      "responsibility": "optional prebuilt customer business administration domain using generated-domain contracts",
      "architectureRole": "BUSINESS_DOMAIN",
      "publicDistributionSurface": "PUBLIC_SOURCE_DEVELOPMENT"
    },
    {
      "prefix": "cpf-education/",
      "owner": "cpf-education",
      "responsibility": "public API and SPI education runtime",
      "architectureRole": "REFERENCE_RUNTIME",
      "publicDistributionSurface": "PUBLIC_SOURCE_DEVELOPMENT"
    },
    {
      "prefix": "cpf-external/",
      "owner": "generated-domain",
      "responsibility": "generated business domain",
      "architectureRole": "BUSINESS_DOMAIN",
      "publicDistributionSurface": "PUBLIC_SOURCE_DEVELOPMENT"
    },
    {
      "prefix": "cpf-starters/",
      "owner": "cpf-starters",
      "responsibility": "starter and auto-configuration products",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "cpf-gateway/",
      "owner": "cpf-gateway",
      "responsibility": "optional gateway runtime",
      "architectureRole": "GATEWAY",
      "publicDistributionSurface": "PUBLIC_BINARY_RUNTIME"
    },
    {
      "prefix": "cpf-common/",
      "owner": "cpf-common",
      "responsibility": "customer business common product contracts, services, policies, repositories and canonical SQL resources",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "cpf-member/",
      "owner": "generated-domain",
      "responsibility": "generated business domain",
      "architectureRole": "BUSINESS_DOMAIN",
      "publicDistributionSurface": "PUBLIC_SOURCE_DEVELOPMENT"
    },
    {
      "prefix": "cpf-admin/",
      "owner": "cpf-admin",
      "responsibility": "platform operations and administration",
      "architectureRole": "PLATFORM_CONTROL_PLANE",
      "publicDistributionSurface": "PUBLIC_BINARY_RUNTIME"
    },
    {
      "prefix": "cpf-batch/",
      "owner": "cpf-batch",
      "responsibility": "batch worker scheduler agent and center-cut runtimes that own canonical BAT/CEC system identities",
      "architectureRole": "BATCH_RUNTIME",
      "publicDistributionSurface": "PUBLIC_BINARY_RUNTIME"
    },
    {
      "prefix": "cpf-tools/",
      "owner": "cpf-tools",
      "responsibility": "generator database verification and release tooling",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "cpf-core/",
      "owner": "cpf-core",
      "responsibility": "topology-independent technical contracts and implementations",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "cpf-docs/",
      "owner": "cpf-docs",
      "responsibility": "governance requirements matrices evidence and guides",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PUBLIC_DOCUMENTATION"
    },
    {
      "prefix": ".github/",
      "owner": "repository-governance",
      "responsibility": "CI and repository governance",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "deploy/",
      "owner": "deploy",
      "responsibility": "deployment topology and environment assets",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    },
    {
      "prefix": "gradle/",
      "owner": "repository-build",
      "responsibility": "Gradle wrapper and build logic",
      "architectureRole": "FRAMEWORK_INTERNAL",
      "publicDistributionSurface": "PRIVATE_INTERNAL"
    }
  ],
  "rootFiles": [
    "build.gradle",
    "settings.gradle",
    "gradle.properties",
    "gradlew",
    "gradlew.bat",
    "README.md",
    ".gitignore",
    ".gitattributes",
    ".editorconfig"
  ],
  "publicPackageMarkers": [
    ".api.",
    ".spi."
  ],
  "internalPackageMarkers": [
    ".internal."
  ],
  "controllerAnnotations": [
    "@RestController",
    "@Controller",
    "@CpfController"
  ],
  "configurationExtensions": [
    ".properties",
    ".yml",
    ".yaml",
    ".toml",
    ".env",
    ".json"
  ],
  "databaseExtensions": [
    ".sql"
  ],
  "frontendExtensions": [
    ".vue",
    ".ts",
    ".tsx",
    ".js",
    ".mjs",
    ".css",
    ".scss"
  ],
  "requiredTraceColumns": [
    "requirement_id",
    "source_paths",
    "consumer_paths",
    "test_paths",
    "development_status",
    "verification_status"
  ],
  "architectureRoles": {
    "BATCH_CONTROL_PLANE": {
      "description": "Batch 운영/제어 Control Plane. Business System 계약 강제 대상이 아니다.",
      "hasSystemCode": false
    },
    "BATCH_RUNTIME": {
      "description": "Batch 실행 Runtime(Worker/Scheduler/Agent/Center-Cut). canonical System Identity(BAT/CEC)를 가진다.",
      "hasSystemCode": true
    },
    "BUSINESS_DOMAIN": {
      "description": "고객 업무 Domain. canonical SystemCode 를 가지며 Business 거래 계약을 적용한다.",
      "hasSystemCode": true
    },
    "CHANNEL_FRONT": {
      "description": "Front/외부 Channel Application. 정본 ChannelCode 를 소유하고 SystemCode 를 가지지 않는다.",
      "hasSystemCode": false
    },
    "FRAMEWORK_INTERNAL": {
      "description": "Framework/Starter/도구/거버넌스 자산. 독립 Runtime System Identity 를 가지지 않는다.",
      "hasSystemCode": false
    },
    "GATEWAY": {
      "description": "Edge/Trust/Route 중계 Component. SystemCode 를 가지지 않는다.",
      "hasSystemCode": false
    },
    "PLATFORM_CONTROL_PLANE": {
      "description": "CPF 운영 Control Plane(ADM). SystemCode 를 가지지 않으며 운영 ChannelCode 로 lineage 를 구성한다.",
      "hasSystemCode": false
    },
    "REFERENCE_RUNTIME": {
      "description": "CPF 공식 Education/Reference Runtime(EDU). canonical SystemCode 를 가진다.",
      "hasSystemCode": true
    },
    "TOPOLOGY": {
      "description": "배치 topology(Same-JVM 1-WAS 등). System 이 아니며 SystemCode 를 가지지 않는다.",
      "hasSystemCode": false
    }
  },
  "nonSystemIdentityCodes": {
    "codes": [
      "CPF",
      "CMN",
      "ADM",
      "GWY",
      "OPS",
      "LOCAL",
      "DEFAULT",
      "UNKNOWN"
    ],
    "reason": "Module Code / DB Physical Prefix / topology 이름이며 Business System Identity 가 아니다(Harness 30.19)."
  },
  "publicDistributionSurfaces": {
    "PUBLIC_SOURCE_DEVELOPMENT": {
      "description": "공개 Consumer 가 Source 를 받아 직접 개발/빌드/테스트하는 Product Surface. Generated/Customer Business Domain, 고객 Backoffice 개발 표면, EDU/Sample 이 여기에 속한다.",
      "capabilities": [
        "BUILD",
        "TEST",
        "VERIFY",
        "RUN",
        "STATUS",
        "STOP",
        "CONFIGURE"
      ],
      "publishesSource": true,
      "publishesRunnableBinary": false,
      "componentGraph": true
    },
    "PUBLIC_BINARY_RUNTIME": {
      "description": "공개 Consumer 가 검증된 Binary 로 실행·구성·검증만 하는 Platform Component. Source/Module Build/Test/Publication Task 는 공개 Release 에 존재해서는 안 된다.",
      "capabilities": [
        "RUN",
        "STATUS",
        "STOP",
        "CONFIGURE",
        "VERIFY_RUNTIME"
      ],
      "publishesSource": false,
      "publishesRunnableBinary": true,
      "componentGraph": true
    },
    "PRIVATE_INTERNAL": {
      "description": "공개 배포 대상이 아닌 내부 구현/도구/거버넌스. Source 도 실행 진입점도 공개하지 않는다.",
      "capabilities": [],
      "publishesSource": false,
      "publishesRunnableBinary": false,
      "componentGraph": true
    },
    "PUBLIC_DOCUMENTATION": {
      "description": "공개 Documentation Allowlist 로만 투영되는 문서 표면. Build/Run Capability 를 갖지 않으며 Gradle Component graph 가 아니다. 어떤 문서가 공개되는지는 문서 Allowlist 가 정한다.",
      "capabilities": [],
      "publishesSource": false,
      "publishesRunnableBinary": false,
      "componentGraph": false
    }
  },
  "publicDistributionSurfaceContract": "모든 moduleOwner 는 publicDistributionSurface 를 선언해야 한다. 선언이 없으면 Release Gate 가 fail-closed 한다(신규 Component 가 분류 없이 공개 Build Surface 로 새어 들어가는 것을 막는다). 이 분류는 새 Identity 축이 아니라 Public Distribution/Product Surface metadata 이며, architectureRole(역할)과 SystemCode(Identity)와는 별개의 축이다.",
  "initialOperatorBootstrapContract": {
    "profiles": [
      "local",
      "dev",
      "stg",
      "test",
      "prod"
    ],
    "sameSecuritySemantics": true,
    "initialBootstrap": {
      "oneTime": true,
      "normalAdministrationRequiresMakerChecker": true,
      "auditAction": "INITIAL_OPERATOR_BOOTSTRAP",
      "auditActor": "CPF_BOOTSTRAP",
      "secrets": {
        "adm": "CPF_ADM_BOOTSTRAP_PASSWORD",
        "mbw": "CPF_MBW_BOOTSTRAP_PASSWORD",
        "secretValueInSourceOrEvidence": false
      }
    },
    "forbiddenProfileSecurityBehavior": [
      "local-fixed-password",
      "local-auto-admin",
      "dev-approval-bypass",
      "prod-only-approval",
      "test-auth-bypass",
      "test-csrf-disable"
    ]
  }
}
