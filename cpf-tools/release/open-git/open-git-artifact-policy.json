{
  "schemaVersion": 2,
  "policyId": "CPF-OPEN-GIT-ARTIFACT",
  "artifactCatalog": "cpf-tools/release/cpf-final-artifact-catalog.json",
  "defaultBinaryPolicy": "ALLOW_PUBLISHED_PUBLIC_ARTIFACT",
  "sourceJarPolicy": {
    "default": "DENY",
    "allowOwnerPathPrefixes": [],
    "denyOwnerPathPrefixes": [
      "cpf-core",
      "cpf-common",
      "cpf-admin",
      "cpf-gateway",
      "cpf-batch",
      "cpf-starters",
      "cpf-tools/runtime/"
    ]
  },
  "javadocJarPolicy": {
    "default": "DENY",
    "allowOwnerPathPrefixes": [],
    "denyOwnerPathPrefixes": [
      "cpf-core",
      "cpf-common",
      "cpf-admin",
      "cpf-gateway",
      "cpf-batch",
      "cpf-starters",
      "cpf-tools/runtime/"
    ]
  },
  "sourceTreeForbiddenOwners": [
    "cpf-core",
    "cpf-common",
    "cpf-admin",
    "cpf-biz-admin",
    "cpf-batch",
    "cpf-gateway",
    "cpf-starters"
  ],
  "requiredBinaryArtifactIdsWhenPublished": [
    "cpf-core",
    "cpf-common",
    "cpf-platform-bom",
    "cpf-gradle-plugin",
    "cpf-generator-cli",
    "cpf-batch-runtime"
  ],
  "binaryOnlyOwnerPrefixes": [
    "cpf-core",
    "cpf-common",
    "cpf-admin",
    "cpf-gateway",
    "cpf-batch",
    "cpf-starters",
    "cpf-tools/runtime/"
  ],
  "notes": [
    "Open Git is a customer development/execution distribution channel, not an open-source repository.",
    "The default binary profile never publishes CPF framework implementation source, sources.jar, or javadoc.jar.",
    "The optional source profile projects only canonical public API/SPI/annotation source from the explicit allowlist; internal modules/source, generator engine source, development/QA harness, evidence, secrets, and internal release tools are forbidden in every profile.",
    "Every profile is freshly generated from one current sourceIdentitySha256 and keeps only the current release."
  ],
  "requiredBinaryContracts": [
    {
      "artifactId": "cpf-core",
      "sourceDisclosure": "DENY"
    },
    {
      "artifactId": "cpf-common",
      "sourceDisclosure": "DENY"
    },
    {
      "artifactId": "cpf-batch-runtime",
      "sourceDisclosure": "DENY"
    },
    {
      "artifactId": "cpf-platform-bom",
      "sourceDisclosure": "NOT_APPLICABLE"
    },
    {
      "artifactId": "cpf-generator-cli",
      "sourceDisclosure": "NOT_APPLICABLE"
    }
  ],
  "defaultProfile": "binary",
  "profiles": {
    "binary": {
      "frameworkImplementationSource": "DENY",
      "sourcesJar": "DENY",
      "javadocJar": "DENY",
      "frameworkPublicSourceProjection": "DENY"
    },
    "source": {
      "frameworkImplementationSource": "ALLOWLIST_ONLY",
      "sourcesJar": "DENY",
      "javadocJar": "DENY",
      "frameworkPublicSourceProjection": "ALLOWLIST_ONLY",
      "allowlist": "cpf-tools/release/open-git/open-git-public-source-allowlist.json"
    }
  },
  "finalPublicTree": {
    "contract": "CPF_OPEN_GIT_FINAL_PUBLIC_TREE",
    "schemaVersion": 1,
    "projection": "ALLOWLIST_FAIL_CLOSED",
    "publicVersionPolicy": {
      "mode": "IMMUTABLE_STABLE_FROM_DEVELOPMENT_VERSION",
      "developmentVersionSource": "gradle/cpf-platform.properties",
      "developmentVersionProperty": "platformVersion",
      "strippedSuffixes": [
        "-SNAPSHOT"
      ],
      "publicSnapshotForbidden": true,
      "timestampedPublicationForbidden": true
    },
    "requiredArtifactTypes": [
      "jar",
      "pom",
      "zip"
    ],
    "admitGradleModuleMetadata": false,
    "admitMavenMetadata": false,
    "admitSourcesJar": false,
    "admitJavadocJar": false,
    "admitChecksumSidecar": false,
    "conditionalAdmissionEvidence": {
      "gradleModuleMetadata": "Fresh isolated Gradle consumer resolved cpf-platform-bom platform + cpf-starter-web-api with 12 transitive CPF artifacts using JAR+POM only.",
      "mavenMetadata": "Public consumers use explicit immutable versions; no dynamic or SNAPSHOT resolution is required."
    },
    "packageManifest": {
      "path": "package-manifest.json",
      "requiredFields": [
        "group",
        "artifactId",
        "module",
        "version",
        "classifier",
        "type",
        "relativePath",
        "fileSize",
        "sha256",
        "publicationType",
        "classification",
        "sourceIdentitySha256"
      ]
    },
    "orphanPolicy": {
      "sidecarWithoutTargetArtifact": "FAIL",
      "fileWithoutManifestEntry": "FAIL",
      "manifestEntryWithoutFile": "FAIL"
    },
    "generatorDistribution": {
      "admitted": true,
      "types": [
        "zip",
        "zip.sha256",
        "json"
      ],
      "reason": "OS별 Generator 배포본은 사용자 Golden Path(Domain 생성)의 필수 Public artifact 다. zip 은 실행체, .sha256/.json 은 그 배포본의 무결성/메타 계약이다.",
      "classifiers": [
        "windows-x64",
        "linux-x64"
      ]
    }
  }
}
