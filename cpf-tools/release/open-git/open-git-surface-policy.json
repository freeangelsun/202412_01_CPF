          "dependencyPackagingQuality"
        ],
        "promotionPolicy": "PROMOTE_AFTER_VERIFICATION",
        "lfsCurrentizationOrder": [
          "freshBuild",
          "testAndRuntimeVerification",
          "checksumSbomManifest",
          "promotion",
          "gitLfsCurrentization"
        ]
      }
    },
    "classificationMapping": {
