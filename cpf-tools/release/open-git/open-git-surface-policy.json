    "acceptance": {
      "masterCheckoutShowsCurrentDeliverable": "Development Master checkout 만으로 현재 Release 구조와 적정 크기의 Current Verified Deliverable 을 확인할 수 있다.",
      "freshReleaseWithoutTrackedResult": "Master 에 보존된 이전 Release Result 를 Fresh Release 입력에서 완전히 배제해도 Canonical Source 만으로 재생성할 수 있다.",
      "bothMustHold": true
    },
    "currentOnly": {
      "meaning": "Working Tree 에는 Current Release 하나만 둔다. 과거 Release 는 Git History 가 담당한다.",
      "forbiddenSiblingPatterns": [
        "release-old",
