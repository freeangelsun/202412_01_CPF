    },
    {
      "pattern": "cpf-backoffice-web/settings.gradle",
      "target": "cpf-backoffice-web/settings.gradle",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/src/**",
      "target": "cpf-backoffice-web/src",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/.nvmrc",
      "target": "cpf-backoffice-web/frontend/.nvmrc",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
