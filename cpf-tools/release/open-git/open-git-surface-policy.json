        ],
        "masterTracked": true,
        "publicRelease": true,
        "releaseInputAuthority": false,
        "freshRegenerationRequired": true,
        "transport": "GIT_LFS",
        "projectionPolicy": "REGENERATED_NOT_COPIED",
        "neverUsedAs": "FRESH_BUILD_CACHE",
        "verificationPolicy": [
