{
  "schemaVersion": 1,
  "policyId": "CPF-OPEN-GIT-SURFACE",
  "repository": "cpf-team/cpf-framework",
  "defaultPolicy": "DENY",
  "releaseRoot": "cpf-release",
  "openGitDirectory": "open-git",
  "binaryRepositoryDirectory": "binary-repository",
  "gitRemoteEnvironment": "CPF_OPEN_GIT_REMOTE",
  "sourceRules": [
    {
      "pattern": ".gitattributes",
      "target": ".gitattributes",
      "classification": "OPEN_GIT_USER_CONFIG",
      "required": true,
      "reason": "Public Runtime binary의 Git LFS transport scope를 canonical source와 exact하게 투영한다."
    },
    {
      "pattern": "cpf-backoffice/build.gradle",
      "target": "cpf-backoffice/build.gradle",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice/settings.gradle",
