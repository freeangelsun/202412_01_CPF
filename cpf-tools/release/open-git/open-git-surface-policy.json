      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/package.json",
      "target": "cpf-backoffice-web/frontend/package.json",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/package-lock.json",
      "target": "cpf-backoffice-web/frontend/package-lock.json",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/tsconfig.json",
      "target": "cpf-backoffice-web/frontend/tsconfig.json",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/vite.config.ts",
      "target": "cpf-backoffice-web/frontend/vite.config.ts",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/src/**",
      "target": "cpf-backoffice-web/frontend/src",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/scripts/**",
      "target": "cpf-backoffice-web/frontend/scripts",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice-web/frontend/openapi/**",
      "target": "cpf-backoffice-web/frontend/openapi",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-education/src/**",
      "target": "cpf-education/src",
      "classification": "OPEN_GIT_EDUCATION_SOURCE",
      "required": true
    },
    {
      "pattern": "gradle/wrapper/**",
      "target": "gradle/wrapper",
      "classification": "OPEN_GIT_BOOTSTRAP",
      "required": true
    },
    {
      "pattern": "cpf-docs/guides/**",
      "target": "cpf-docs/guides",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Framework/Batch developer guides, operator manual, Gateway guide, Specification."
    },
    {
      "pattern": "cpf-docs/assets/product-docs/**",
      "target": "cpf-docs/assets/product-docs",
      "classification": "OPEN_GIT_PUBLIC_DOC_ASSET",
      "required": true,
      "reason": "Images referenced by the public documents."
    },
    {
      "pattern": "cpf-docs/legal/THIRD_PARTY_NOTICES.md",
      "target": "cpf-docs/legal/THIRD_PARTY_NOTICES.md",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "License attribution must ship with any binary distribution."
    },
    {
      "pattern": "cpf-docs/operations/BUILD_AND_DEPLOYMENT_TOPOLOGY_GUIDE.md",
      "target": "cpf-docs/operations/BUILD_AND_DEPLOYMENT_TOPOLOGY_GUIDE.md",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Operators need the deployment topology for the public runtimes."
    },
    {
      "pattern": "cpf-docs/deliverables/기술사양서.pdf",
      "target": "cpf-docs/deliverables/기술사양서.pdf",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Contracted public specification."
    },
    {
      "pattern": "cpf-docs/deliverables/기술표준서.pdf",
      "target": "cpf-docs/deliverables/기술표준서.pdf",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Contracted public technical standard."
    },
    {
      "pattern": "cpf-docs/deliverables/데이터베이스표준서.pdf",
      "target": "cpf-docs/deliverables/데이터베이스표준서.pdf",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Contracted public database standard."
    },
    {
      "pattern": "cpf-docs/deliverables/아키텍처설계서.pdf",
      "target": "cpf-docs/deliverables/아키텍처설계서.pdf",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Contracted public architecture design."
    },
    {
      "pattern": "cpf-docs/deliverables/산출물목록.pdf",
      "target": "cpf-docs/deliverables/산출물목록.pdf",
      "classification": "OPEN_GIT_PUBLIC_DOC",
      "required": true,
      "reason": "Contracted public artifact list."
    },
    {
      "pattern": "gradle/cpf-runtime/**",
      "target": "gradle/cpf-runtime",
      "classification": "OPEN_GIT_USER_CONFIG",
      "required": true,
      "reason": "gradlew wrapper 가 기동 시 gradle/cpf-runtime/{common,profile}.properties 를 fail-closed 로 요구한다. 없으면 Fresh checkout 사용자가 어떤 Gradle 명령도 실행할 수 없다."
    },
    {
      "pattern": "cpf-tools/db/vendor/mariadb/**",
      "target": "deploy/local/db/vendor/mariadb",
      "classification": "OPEN_GIT_DEPLOY_ASSET",
      "required": true
    },
    {
      "pattern": "cpf-tools/db/vendor/oracle/**",
      "target": "deploy/local/db/vendor/oracle",
      "classification": "OPEN_GIT_DEPLOY_ASSET",
      "required": true
    },
    {
      "pattern": "cpf-tools/db/vendor/postgresql/**",
      "target": "deploy/local/db/vendor/postgresql",
      "classification": "OPEN_GIT_DEPLOY_ASSET",
      "required": true
    }
  ],
