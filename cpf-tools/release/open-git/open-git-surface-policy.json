        "release-copy",
        "backup-release"
      ]
    },
    "artifactClassification": {
      "contract": "CPF_RELEASE_ARTIFACT_CLASSIFICATION",
      "unknownArtifact": "FAIL_CLOSED",
      "unknownArtifactNote": "새 Artifact 가 분류 없이 등장하면 통과시키지 않는다. 확장자만 보고 자동 제외하지 않는다.",
      "derivedFrom": {
        "authority": "cpf-tools/runtime/cpf-runtime-target-catalog.json",
        "selector": "runtimes[provision=binary].artifactId",
        "note": "크기 threshold 를 쓰지 않는다. Public Binary Runtime 의 실행물이라는 성격으로 분류한다."
      },
      "rules": [
        {
          "id": "publicBinaryRuntimeExecutable",
          "match": {
            "root": "cpf-release/binary-repository/com/cpf/runtime",
            "artifactIdFrom": "runtimeTargetCatalog.binaryProvisionArtifactIds",
            "fileKind": "executable-runtime-jar"
          },
          "assetClass": "LARGE_RELEASE_BINARY",
          "masterTracked": true,
          "publicRelease": true,
          "transport": "GIT_LFS",
          "selection": "runtimeTargetCatalog.binaryProvisionArtifactIds",
          "transportDecisionEvidence": "cpf-docs/governance/development-harness/current/RELEASE_BINARY_TRACKING_MANIFEST.csv",
          "note": "LFS 대상은 runtime catalog가 선언한 executable product runtime이다. 확장자·일반 경로·임의 용량 기준으로 다른 JAR에 확장하지 않는다.",
          "binaryRepositoryRelativePathTemplate": "com/cpf/runtime/{artifactId}/*/{artifactId}-*.jar"
        },
        {
          "id": "generatorDistribution",
          "match": {
            "root": "cpf-release/binary-repository/com/cpf/tooling",
            "fileKind": "generator-distribution-archive"
          },
          "assetClass": "TRACKED_VERIFIED_RELEASE_RESULT",
          "masterTracked": true,
          "publicRelease": true,
          "transport": "REGULAR_GIT",
          "note": "Windows/Linux Generator 배포본. 2026-09-05 실측 8.0MB / 7.7MB 로 Git 운영 문제가 없어 보존한다. binary 라는 이유만으로 제외하지 않는다."
        },
        {
          "id": "releaseMetadata",
          "match": {
            "root": "cpf-release/binary-repository",
            "fileKind": "pom|checksum|manifest|module-metadata|maven-metadata"
          },
          "assetClass": "TRACKED_VERIFIED_RELEASE_RESULT",
          "masterTracked": true,
          "publicRelease": true,
          "transport": "REGULAR_GIT",
          "note": "적정 크기의 Current Verified Release Metadata 는 Master 에서 보존한다."
        },
        {
          "id": "libraryArtifact",
          "match": {
            "root": "cpf-release/binary-repository",
            "fileKind": "library-jar"
          },
          "assetClass": "TRACKED_VERIFIED_RELEASE_RESULT",
          "masterTracked": true,
          "publicRelease": true,
          "transport": "REGULAR_GIT",
          "note": "Runtime 실행물이 아닌 라이브러리 jar 은 크기 문제가 없어 보존한다."
        },
        {
          "id": "releaseReport",
          "match": {
            "root": "cpf-release/reports",
            "fileKind": "any"
          },
          "assetClass": "TRACKED_VERIFIED_RELEASE_RESULT",
          "masterTracked": true,
          "publicRelease": false,
          "transport": "REGULAR_GIT",
          "note": "Release 검수용 Current Metadata 다. 공개 배포본에는 넣지 않는다."
        }
      ],
      "trackedManifest": "cpf-docs/governance/development-harness/current/RELEASE_BINARY_TRACKING_MANIFEST.csv",
      "trackedManifestColumns": [
        "artifact_path",
        "coordinate",
        "version",
        "size_bytes",
        "sha256",
        "source_identity",
        "master_tracked",
        "public_release",
        "asset_class",
        "transport",
        "lfs_required",
        "tracking_exception_reason"
      ],
      "gitLfs": {
        "adopted": true,
        "attributeFile": ".gitattributes",
        "requiredCommand": "git-lfs",
        "pointerPrefix": "version https://git-lfs.github.com/spec/v1",
        "largeArtifactClass": "LARGE_RELEASE_BINARY",
        "attributeSource": "artifactClassification.rules[id=publicBinaryRuntimeExecutable].binaryRepositoryRelativePathTemplate expanded from runtimeTargetCatalog.binaryProvisionArtifactIds, prefixed by each repository의 Binary Repository 위치",
        "ordinaryGitClasses": [
          "CANONICAL_RELEASE_SOURCE",
          "TRACKED_VERIFIED_RELEASE_RESULT"
        ],
        "materializationRequiredBeforeRuntime": true,
        "currentizationRule": "Fresh Build -> Test/Runtime verify -> checksum/SBOM/manifest -> promotion -> Git LFS currentization. Previous LFS object is never a Fresh Release input.",
        "failClosedCodes": [
          "GIT_LFS_NOT_AVAILABLE",
          "LFS_OBJECT_NOT_MATERIALIZED",
          "LFS_DOWNLOAD_FAILED",
          "LFS_HASH_MISMATCH",
          "RELEASE_MANIFEST_MISMATCH",
          "RUNTIME_ARTIFACT_INVALID",
          "LFS_ATTRIBUTE_NOT_APPLIED",
          "GIT_TRANSPORT_LIMIT_EXCEEDED"
        ],
        "attributePrefixRule": "Development Master는 releaseRoot/binaryRepositoryDirectory, Open Git 공개 저장소는 checkout 최상위의 binaryRepositoryDirectory다. 한쪽 경로를 정답으로 고정하면 다른 쪽에서 어떤 패턴도 매칭되지 않고, 문자열 비교만 하는 검증은 그대로 PASS를 낸다.",
        "attributeEffectVerification": "git check-attr filter가 실제 Artifact 경로에 lfs를 적용하는지 확인한다. .gitattributes 문자열 일치는 근거가 아니다.",
        "regularGitTransportLimitBytes": 104857600,
        "regularGitTransportLimitOwner": "GitHub per-file hard limit. External transport constraint only — never a CPF packaging target, never a reason to delete a required runtime dependency."
      }
    }
  },
  "releaseProducedAssets": {
    "contract": "CPF_RELEASE_PRODUCED_ASSETS",
    "intent": [
      "Release 엔진이 만들어 내는 자산의 부류도 metadata 로 선언한다.",
      "이 자산들은 Master 보존 여부와 무관하게 매 Fresh Release 에서 Current Source 기준으로 다시 만든다.",
      "path 는 공개 배포본(Open Git tree) 기준 상대 경로 또는 Release 작업 영역 표기다."
    ],
    "assets": [
      {
        "name": "publicBinaryRepository",
        "path": "binary-repository",
        "producedBy": "sanitize_binary_repository",
        "releaseAssetClass": "TRACKED_VERIFIED_RELEASE_RESULT",
        "note": "staging repository 를 입력으로 하는 투영 결과. 발행 대상으로 직접 지정하지 않는다."
