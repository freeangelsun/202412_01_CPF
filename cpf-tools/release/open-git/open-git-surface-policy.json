{
  "schemaVersion": 1,
  "policyId": "CPF-OPEN-GIT-SURFACE",
  "repository": "cpf-team/cpf-framework",
  "defaultPolicy": "DENY",
  "releaseRoot": "cpf-release",
  "openGitDirectory": "open-git",
  "binaryRepositoryDirectory": "binary-repository",
  "gitRemoteEnvironment": "CPF_OPEN_GIT_REMOTE",
  "sourceRules": [
    {
      "pattern": "cpf-backoffice/build.gradle",
      "target": "cpf-backoffice/build.gradle",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice/settings.gradle",
      "target": "cpf-backoffice/settings.gradle",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice/gradle.properties",
      "target": "cpf-backoffice/gradle.properties",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
    },
    {
      "pattern": "cpf-backoffice/online/build.gradle",
      "target": "cpf-backoffice/online/build.gradle",
      "classification": "OPEN_GIT_BACKOFFICE_SOURCE",
      "required": false,
      "option": "backoffice"
