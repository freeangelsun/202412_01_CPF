  "allowedClassifications": [
    "OPEN_GIT_USER_DOC",
    "OPEN_GIT_USER_SCRIPT",
    "OPEN_GIT_USER_CONFIG",
    "OPEN_GIT_GENERATED_DOMAIN_SOURCE",
    "OPEN_GIT_BACKOFFICE_SOURCE",
    "OPEN_GIT_EDUCATION_SOURCE",
    "OPEN_GIT_EDUCATION_BUILD",
    "OPEN_GIT_BOOTSTRAP",
    "OPEN_GIT_DEPLOY_ASSET",
    "PUBLIC_RELEASE_METADATA",
    "PUBLIC_GENERATED_SOURCE",
    "OPEN_GIT_CLI_BINARY",
    "OPEN_GIT_PUBLIC_DOC",
    "OPEN_GIT_PUBLIC_DOC_ASSET"
  ],
  "forbiddenPathPrefixes": [
    "cpf-core/",
    "cpf-common/",
    "cpf-admin/",
    "cpf-biz-admin/",
    "cpf-batch/",
    "cpf-gateway/",
    "cpf-starters/",
    "cpf-tools/",
    ".git/",
    "cpf-docs/governance/",
    "cpf-docs/work/",
    "cpf-docs/development/",
    "cpf-docs/environment/",
    "cpf-docs/brand/",
    "cpf-docs/architecture/"
  ],
  "forbiddenNamePatterns": [
    "cpf-domain.yaml",
    "cpf-generator.lock.json",
    "*.pem",
    "*.p12",
    "*.pfx",
    "*.jks",
    "*.keystore",
    ".env",
    ".env.*"
  ],
  "forbiddenContentPatterns": [
    "-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
    "AKIA[0-9A-Z]{16}",
    "(?i)(?:password|secret|token)\\s*[:=]\\s*['\\\"][^'\\\"+${}\\r\\n]{12,}['\\\"]",
    "(?i)(?:C:|D:)[\\\\/]+Users[\\\\/]"
  ],
  "mandatoryDomainProjects": [],
  "gitWriteBoundary": {
    "privateRepository": "READ_ONLY",
    "privateForbiddenOperations": [
      "add",
      "commit",
      "push",
      "branch",
      "tag",
      "reset",
      "restore",
      "stash",
      "clean"
    ],
