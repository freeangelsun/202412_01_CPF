#!/usr/bin/env sh
set -eu
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
CLI="$SCRIPT_DIR/lib/cpf-cli.jar"
JAVA_BIN=${JAVA_HOME:+$JAVA_HOME/bin/java}
if [ -z "${JAVA_BIN:-}" ]; then JAVA_BIN=java; fi
[ -f "$CLI" ] || { echo "CPF_CLI=FAIL code=CPF-CLI-JAR-MISSING message=$CLI" >&2; exit 69; }
exec "$JAVA_BIN" -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -jar "$CLI" "$@"
