{
  "openapi": "3.1.0",
  "info": {
    "title": "CPF ADM Integration Closure API",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/adm/api/integration-closure/crypto/status": {
      "get": {
        "operationId": "admIntegrationCryptoStatus",
        "summary": "Crypto provider and active key version status",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or SoD violation"
          },
          "404": {
            "description": "Target not found"
          },
          "409": {
            "description": "Optimistic concurrency or approval conflict"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/adm/api/integration-closure/time/health": {
      "get": {
        "operationId": "admIntegrationTimeHealth",
        "summary": "UTC/business time and skew health",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or SoD violation"
          },
          "404": {
            "description": "Target not found"
          },
          "409": {
            "description": "Optimistic concurrency or approval conflict"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "zone",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "maxSkewMillis",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/adm/api/integration-closure/data-quality/validate/{recordId}": {
      "post": {
        "operationId": "admIntegrationDataQualityValidate",
        "summary": "Validate data quality",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or SoD violation"
          },
          "404": {
            "description": "Target not found"
          },
          "409": {
            "description": "Optimistic concurrency or approval conflict"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "recordId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        }
      }
    },
    "/adm/api/integration-closure/data-quality/quarantine/{id}/correction-approvals": {
      "post": {
        "operationId": "admIntegrationDataQualityCorrectionApprovalRequest",
        "summary": "Create immutable correction approval",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or SoD violation"
          },
          "404": {
            "description": "Target not found"
          },
          "409": {
            "description": "Optimistic concurrency or approval conflict"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionApprovalRequest"
              }
            }
          }
        }
      }
    },
    "/adm/api/integration-closure/data-quality/correction-approvals/{approvalRequestId}/execute": {
      "post": {
        "operationId": "admIntegrationDataQualityCorrectionExecute",
        "summary": "Execute one approved correction",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
