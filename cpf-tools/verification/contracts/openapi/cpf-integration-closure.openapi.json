          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/adm/api/integration-closure/webhooks/{id}/replay": {
      "post": {
        "operationId": "admIntegrationWebhookReplay",
        "summary": "Replay DLQ/UNKNOWN Webhook",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient permission or SoD violation"
          },
          "404": {
            "description": "Target not found"
          },
          "409": {
            "description": "Optimistic concurrency or approval conflict"
          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "expectedVersion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "reason",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CorrectionApprovalRequest": {
        "type": "object",
        "required": [
          "expectedVersion",
          "idempotencyKey",
          "reason",
          "corrected"
        ],
        "properties": {
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "corrected": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "CorrectionExecutionRequest": {
        "type": "object",
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    }
  }
}
