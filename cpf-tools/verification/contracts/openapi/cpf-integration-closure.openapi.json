          },
          "429": {
            "description": "Rate limited"
          },
          "500": {
            "description": "Internal error"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "parameters": [
          {
            "name": "approvalRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionExecutionRequest"
              }
            }
          }
        }
      }
    },
    "/adm/api/integration-closure/data-quality/quarantine/{id}/replay": {
      "post": {
        "operationId": "admIntegrationDataQualityReplay",
        "summary": "Replay quarantined record",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
