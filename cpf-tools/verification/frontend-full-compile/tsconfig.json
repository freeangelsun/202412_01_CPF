{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "allowJs": false,
    "isolatedModules": false,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false
  },
  "include": [
    "shims.d.ts",
    "../../../cpf-admin/frontend/src/**/*.ts",
    "../../../cpf-backoffice-web/frontend/src/**/*.ts",
    "../../../cpf-tools/db/metadata/backoffice-permission-manifest.json"
  ]
}
