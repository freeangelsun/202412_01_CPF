SPRING_PROFILES_ACTIVE=local
MBW_ONLINE_PORT=18091
MBW_DATASOURCE_URL=jdbc:mariadb://localhost:3306/backofficeDB
MBW_DATASOURCE_USERNAME=cpf_mbw_app
MBW_DATASOURCE_PASSWORD=__REPLACE_BY_ENV__
MBW_DATASOURCE_DRIVER=org.mariadb.jdbc.Driver
CPF_MBW_JWT_SECRET=__REPLACE_BY_SECRET_PROVIDER__
CPF_MBW_ACCESS_TOKEN_TTL_SECONDS=600
CPF_MBW_REFRESH_TOKEN_TTL_SECONDS=7200
# instanceId 미지정 시 CPF Runtime Identity 정본에 따라 Runtime Hostname을 사용합니다.
