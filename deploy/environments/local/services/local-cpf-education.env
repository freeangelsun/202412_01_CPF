SPRING_PROFILES_ACTIVE=local
EDU_MODULE_ID=EDU
EDU_INSTANCE_ID=edu-local-01
EDU_WAS_ID=eduAP01
EDU_SERVER_PORT=8099
CPF_LOG_ROOT=C:/cpf/runtime/logs
CPF_DB_MODE=url
CPF_DB_URL=jdbc:mariadb://localhost:3306/cpfDB
CPF_DB_USERNAME=cpf_app
CPF_DB_PASSWORD=__REPLACE_BY_ENV__
CPF_DB_JNDI_NAME=java:comp/env/jdbc/cpfCoreDataSource
# EDU는 DB Schema/Migration/Seed를 소유하지 않습니다. Education Sample Data 연결은 DB Tool profile에서 명시적으로 주입합니다.
CPF_CMN_SAMPLE_DB_ENABLED=${CPF_CMN_SAMPLE_DB_ENABLED:false}
