[Unit]
Description=CPF cpf-batch-center-cut
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=cpf
Group=cpf
EnvironmentFile=-/etc/cpf/cpf-batch-center-cut.env
ExecStart=/opt/cpf/bin/cpf-batch-center-cut.sh run
Restart=on-failure
RestartSec=5
TimeoutStopSec=600
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cpf/cpf-batch-center-cut /var/log/cpf/cpf-batch-center-cut
[Install]
WantedBy=multi-user.target
