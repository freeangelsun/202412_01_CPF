[Unit]
Description=CPF cpf-batch-control-plane
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=cpf
Group=cpf
EnvironmentFile=-/etc/cpf/cpf-batch-control-plane.env
ExecStart=/opt/cpf/bin/cpf-batch-control-plane.sh run
Restart=on-failure
RestartSec=5
TimeoutStopSec=600
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/cpf/cpf-batch-control-plane /var/log/cpf/cpf-batch-control-plane
[Install]
WantedBy=multi-user.target
